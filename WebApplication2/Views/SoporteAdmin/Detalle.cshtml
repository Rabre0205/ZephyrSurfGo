@model ClassLibrary.Soporte.SolicitudSoporte
@{ ViewData["Title"]="Responder consulta"; }
<div class="container py-5" style="max-width:900px"><a asp-action="Index">← Volver</a><h1 class="mt-3">@Model.Asunto</h1><p><strong>@Model.ShaperNombre</strong> · @Model.ShaperEmail · @Model.EstadoNombre</p><div class="card p-4 my-4"><h2 class="h5">Mensaje del shaper</h2><p style="white-space:pre-wrap">@Model.Mensaje</p></div>
@if(TempData["Mensaje"]!=null){<div class="alert alert-success">@TempData["Mensaje"]</div>}<form asp-action="Responder" method="post" class="card p-4">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"><label class="form-label">Respuesta</label><textarea class="form-control" name="respuesta" rows="7" maxlength="2000" required>@Model.Respuesta</textarea><div class="form-check my-3"><input class="form-check-input" type="checkbox" name="cerrar" value="true" id="cerrar"><label class="form-check-label" for="cerrar">Cerrar la consulta después de responder</label></div><button class="btn btn-primary align-self-start">Guardar respuesta</button></form></div>
