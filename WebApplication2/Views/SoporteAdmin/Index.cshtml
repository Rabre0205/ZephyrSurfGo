@model List<ClassLibrary.Soporte.SolicitudSoporte>
@{ ViewData["Title"]="Ayuda de shapers"; }
<div class="container py-5"><div class="d-flex justify-content-between align-items-end mb-4"><div><small>ADMINISTRACIÓN</small><h1 class="display-4">Ayuda de shapers</h1><p>Consultas enviadas por las marcas de la plataforma.</p></div><span class="badge bg-success fs-6">@Model.Count(s=>s.Estado==0) abiertas</span></div>
@if(Model.Count==0){<div class="card p-5 text-center"><h2>No hay consultas</h2></div>}else{<div class="card"><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Shaper</th><th>Asunto</th><th>Fecha</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var s in Model){<tr><td><strong>@s.ShaperNombre</strong><br><small>@s.ShaperEmail</small></td><td>@s.Asunto</td><td>@s.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@s.EstadoNombre</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Detalle" asp-route-id="@s.Id">Ver</a></td></tr>}</tbody></table></div></div>}</div>
