@model WebApplication2.Models.CatalogoViewModel
@{ Layout=null; ViewData["Title"]="Catálogo"; }
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Catálogo — Zephyr Surf Go</title><link rel="stylesheet" href="~/css/editorialSite.css" asp-append-version="true"><link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true"><link rel="stylesheet" href="~/css/catalogo.css" asp-append-version="true"></head>
<body><partial name="_Navbar"/><main class="catalogo-page"><header><span>Equipamiento seleccionado</span><h1>CATÁLOGO</h1><p>Tablas y accesorios publicados por shapers verificados.</p></header>
<form method="get" class="catalogo-filtros"><label class="search">Buscar<input name="busqueda" value="@Model.Busqueda" placeholder="Nombre, modelo o shaper"></label><label>Tipo<select name="tipo"><option value="">Todos</option>@foreach(var t in new[]{"Tabla","Quilla","Leash","Pad","Traje"}){<option value="@t" selected="@(Model.Tipo==t)">@t</option>}</select></label><label>Precio mínimo<input type="number" name="precioMin" value="@Model.PrecioMin" min="0" step="10"></label><label>Precio máximo<input type="number" name="precioMax" value="@Model.PrecioMax" min="0" step="10"></label><label>Ordenar<select name="ordenar"><option value="nuevos" selected="@(Model.Ordenar=="nuevos")">Más recientes</option><option value="precio_asc" selected="@(Model.Ordenar=="precio_asc")">Menor precio</option><option value="precio_desc" selected="@(Model.Ordenar=="precio_desc")">Mayor precio</option><option value="valorados" selected="@(Model.Ordenar=="valorados")">Mejor valorados</option></select></label><label class="check"><input type="checkbox" name="soloDisponibles" value="true" checked="@Model.SoloDisponibles"> Sólo disponibles</label><button>Aplicar filtros</button><a asp-action="Index">Limpiar</a></form>
<div class="catalogo-resultados"><strong>@Model.Total</strong> productos encontrados</div>
@if(Model.Productos.Count==0){<section class="catalogo-vacio"><h2>No encontramos productos</h2><p>Probá quitando algún filtro o usando otra búsqueda.</p></section>}else{<section class="productos-grid">@foreach(var p in Model.Productos){<article class="producto-card"><a asp-controller="Shaper" asp-action="Producto" asp-route-id="@p.Id" class="foto">@if(!string.IsNullOrWhiteSpace(p.ImagenUrl)){<img src="@p.ImagenUrl" alt="@p.Titulo">}<span class="estado @(p.Disponible?"ok":"no")">@(p.Disponible?"Disponible":"Sin stock")</span></a><div class="info"><small>@p.Tipo · @p.Pais</small><h2>@p.Titulo</h2><p>@p.Subtitulo</p><a asp-controller="Shaper" asp-action="Index" asp-route-id="@p.ShaperId">@p.Shaper</a><div class="pie"><strong>USD @p.Precio.ToString("N2")</strong><span>★ @p.PromedioResenas.ToString("0.0") (@p.CantidadResenas)</span></div></div></article>}</section>}
@if(Model.TotalPaginas>1){<nav class="paginacion">@for(int i=1;i<=Model.TotalPaginas;i++){<a class="@(i==Model.Pagina?"activo":"")" asp-route-busqueda="@Model.Busqueda" asp-route-tipo="@Model.Tipo" asp-route-precioMin="@Model.PrecioMin" asp-route-precioMax="@Model.PrecioMax" asp-route-soloDisponibles="@Model.SoloDisponibles" asp-route-ordenar="@Model.Ordenar" asp-route-pagina="@i">@i</a>}</nav>}</main><script src="~/js/navbar.js"></script></body></html>
