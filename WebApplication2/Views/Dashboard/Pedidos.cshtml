@model WebApplication2.Models.Dashboard.PedidosShaperViewModel
@{ Layout = null; ViewData["Title"] = "Pedidos recibidos"; }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/>
<title>Pedidos - Zephyr Surf Go</title><link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true"/><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/></head>
<body class="shaper-ops-page"><partial name="_Navbar"/><main class="container py-5 shaper-content-page">
<header class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4"><div><small class="text-uppercase text-success fw-bold">Ventas</small><h1 class="display-4 fw-bold mb-1">Pedidos recibidos</h1><p class="text-secondary mb-0">Revisá los pedidos de tu negocio. En las tablas personalizadas podés cotizar y publicar novedades para el cliente.</p></div><span class="badge text-bg-success fs-6">@Model.TotalResultados @(Model.TotalResultados==1?"pedido":"pedidos")</span></header>
<form method="get" class="row g-2 mb-4 pedidos-filtros">
    <div class="col-lg"><label class="visually-hidden" for="busquedaPedidos">Buscar pedidos</label><input id="busquedaPedidos" class="form-control" type="search" name="busqueda" value="@Model.Busqueda" placeholder="Número, cliente, correo o modelo..."/></div>
    <div class="col-md-3"><label class="visually-hidden" for="tipoPedido">Tipo de pedido</label><select id="tipoPedido" class="form-select" name="tipo"><option value="todos" selected="@(Model.Tipo == "todos" ? "selected" : null)">Todos los pedidos</option><option value="compras" selected="@(Model.Tipo == "compras" ? "selected" : null)">Compras de productos</option><option value="personalizados" selected="@(Model.Tipo == "personalizados" ? "selected" : null)">Tablas personalizadas</option></select></div>
    <div class="col-md-3"><label class="visually-hidden" for="estadoPedido">Estado</label><select id="estadoPedido" class="form-select" name="estado"><option value="" selected="@(string.IsNullOrEmpty(Model.EstadoFiltro) ? "selected" : null)">Todos los estados</option><optgroup label="Compras"><option value="compra:0" selected="@(Model.EstadoFiltro == "compra:0" ? "selected" : null)">Pendiente</option><option value="compra:1" selected="@(Model.EstadoFiltro == "compra:1" ? "selected" : null)">Aprobado</option><option value="compra:2" selected="@(Model.EstadoFiltro == "compra:2" ? "selected" : null)">Rechazado</option><option value="compra:3" selected="@(Model.EstadoFiltro == "compra:3" ? "selected" : null)">Cancelado</option><option value="compra:4" selected="@(Model.EstadoFiltro == "compra:4" ? "selected" : null)">Completado</option></optgroup><optgroup label="Tablas personalizadas"><option value="personalizado:0" selected="@(Model.EstadoFiltro == "personalizado:0" ? "selected" : null)">Esperando cotización</option><option value="personalizado:1" selected="@(Model.EstadoFiltro == "personalizado:1" ? "selected" : null)">Cotizado</option><option value="personalizado:2" selected="@(Model.EstadoFiltro == "personalizado:2" ? "selected" : null)">No disponible</option><option value="personalizado:3" selected="@(Model.EstadoFiltro == "personalizado:3" ? "selected" : null)">Aceptado</option><option value="personalizado:4" selected="@(Model.EstadoFiltro == "personalizado:4" ? "selected" : null)">Rechazado</option><option value="personalizado:5" selected="@(Model.EstadoFiltro == "personalizado:5" ? "selected" : null)">Esperando pago</option><option value="personalizado:6" selected="@(Model.EstadoFiltro == "personalizado:6" ? "selected" : null)">Pagado</option><option value="personalizado:7" selected="@(Model.EstadoFiltro == "personalizado:7" ? "selected" : null)">En preparación</option><option value="personalizado:8" selected="@(Model.EstadoFiltro == "personalizado:8" ? "selected" : null)">Enviado o listo para retirar</option><option value="personalizado:9" selected="@(Model.EstadoFiltro == "personalizado:9" ? "selected" : null)">Entregado</option></optgroup></select></div>
    <div class="col-auto d-flex gap-2"><button class="btn btn-success">Filtrar pedidos</button>@if(!string.IsNullOrWhiteSpace(Model.Busqueda)||Model.Tipo!="todos"||!string.IsNullOrWhiteSpace(Model.EstadoFiltro)){<a asp-action="Pedidos" class="btn btn-outline-success">Limpiar</a>}</div>
</form>
@if(!Model.Personalizados.Any() && !Model.Pedidos.Any()){<section class="border rounded-4 p-5 text-center"><h2>Sin pedidos</h2><p class="text-secondary mb-0">Los pedidos de tus clientes aparecerán aquí.</p></section>}else{
@if(Model.Personalizados.Any()){<section class="mb-4"><h2 class="h4 mb-3">Tablas personalizadas</h2><div class="table-responsive border border-warning rounded-4"><table class="table align-middle mb-0"><thead class="table-warning"><tr><th>Pedido</th><th>Fecha</th><th>Cliente</th><th>Modelo</th><th>Estado</th><th></th></tr></thead><tbody>@foreach(var p in Model.Personalizados){<tr><td><strong>Personalizado #@p.Id</strong></td><td>@p.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><strong>@p.ClienteNombre</strong><br/><small class="text-secondary">@p.ClienteEmail</small></td><td>@p.Modelo</td><td>@p.EstadoNombre</td><td><a asp-controller="SolicitudPersonalizada" asp-action="DetalleShaper" asp-route-id="@p.Id" class="btn btn-sm btn-outline-success">Revisar pedido</a></td></tr>}</tbody></table></div></section>}
@if(Model.Pedidos.Any()){<section><h2 class="h4 mb-3">Compras de productos</h2><div class="table-responsive border rounded-4"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>Pedido</th><th>Fecha</th><th>Cliente</th><th>Estado</th><th>Total</th><th>Ingreso estimado</th><th></th></tr></thead><tbody>@foreach(var p in Model.Pedidos){<tr><td><strong>#@p.Id</strong></td><td>@p.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><strong>@p.ClienteNombre</strong><br/><small class="text-secondary">@p.ClienteEmail</small></td><td>@p.EstadoNombre</td><td>USD @p.Total.ToString("N2")</td><td>USD @((p.Total-p.ComisionPlataforma).ToString("N2"))</td><td><a asp-action="DetallePedido" asp-route-id="@p.Id" class="btn btn-sm btn-outline-success">Ver detalle</a></td></tr>}</tbody></table></div></section>}}
@if(Model.TotalPaginas>1){<nav class="d-flex justify-content-center align-items-center gap-3 mt-4">@if(Model.TienePaginaAnterior){<a asp-route-busqueda="@Model.Busqueda" asp-route-tipo="@Model.Tipo" asp-route-estado="@Model.EstadoFiltro" asp-route-pagina="@(Model.PaginaActual-1)" class="btn btn-outline-success">← Anterior</a>}<span>Página @Model.PaginaActual de @Model.TotalPaginas</span>@if(Model.TienePaginaSiguiente){<a asp-route-busqueda="@Model.Busqueda" asp-route-tipo="@Model.Tipo" asp-route-estado="@Model.EstadoFiltro" asp-route-pagina="@(Model.PaginaActual+1)" class="btn btn-outline-success">Siguiente →</a>}</nav>}
<a asp-action="Index" class="d-inline-block mt-4 text-success fw-bold text-decoration-none">← Volver al dashboard</a></main><script src="~/js/navbar.js" asp-append-version="true"></script></body></html>
