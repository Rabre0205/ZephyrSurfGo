@model ClassLibrary.Pedidos.PedidoAdminDetalle
@{ Layout=null; }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Pedido #@Model.Id</title><link rel="stylesheet" href="~/css/navbar.css"/><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/></head><body><partial name="_Navbar"/><main class="container py-5">
<small class="text-uppercase text-success fw-bold">Pedido recibido</small><h1 class="display-4 fw-bold">Pedido #@Model.Id</h1><p class="text-secondary">@Model.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
<div class="row g-3 my-4"><div class="col-md-4"><section class="border rounded-4 p-3 h-100"><small class="text-secondary">Cliente</small><h2 class="h5 mt-2">@Model.ClienteNombre</h2><p class="mb-0">@Model.ClienteEmail</p></section></div><div class="col-md-4"><section class="border rounded-4 p-3 h-100"><small class="text-secondary">Estado</small><h2 class="h5 mt-2">@Model.EstadoNombre</h2></section></div><div class="col-md-4"><section class="border rounded-4 p-3 h-100"><small class="text-secondary">Ingreso estimado</small><h2 class="h5 mt-2">USD @((Model.Total-Model.ComisionPlataforma).ToString("N2"))</h2><p class="mb-0 text-secondary">Total: USD @Model.Total.ToString("N2") · Comisión: USD @Model.ComisionPlataforma.ToString("N2")</p></section></div></div>
<section class="border rounded-4 overflow-hidden"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>Producto</th><th>Precio</th><th>Cantidad</th><th>Subtotal</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.TituloSnapshot</td><td>USD @item.PrecioUnitarioSnapshot.ToString("N2")</td><td>@item.Cantidad</td><td><strong>USD @((item.PrecioUnitarioSnapshot*item.Cantidad).ToString("N2"))</strong></td></tr>}</tbody></table></section>
<div class="alert alert-light border mt-4">Vista de solo lectura. Los cambios de estado se habilitarán cuando se apruebe el flujo operativo.</div><a asp-action="Pedidos" class="text-success fw-bold text-decoration-none">← Volver a pedidos</a></main><script src="~/js/navbar.js"></script></body></html>
