@using System.Security.Claims

@{
    bool estaLogueado = User.Identity?.IsAuthenticated ?? false;

    string? rol = estaLogueado
        ? User.FindFirstValue(ClaimTypes.Role)
        : null;

    bool esCliente = string.Equals(
        rol,
        "Cliente",
        StringComparison.OrdinalIgnoreCase
    );

    bool esShaper = string.Equals(
        rol,
        "Shaper",
        StringComparison.OrdinalIgnoreCase
    );
}

<nav id="navbar">

    <a asp-controller="Surf"
       asp-action="Home"
       class="nav-logo">
        ZEPHYR <span>SURF</span> GO
    </a>

    <ul class="nav-links d-none d-md-flex">

        @* Visitante y cliente *@
        @if (!esShaper)
        {
            <li>
                <a asp-controller="Surf"
                   asp-action="Home">
                    Home
                </a>
            </li>

            <li>
                <a asp-controller="Surf"
                   asp-action="Home"
                   asp-fragment="tablas">
                    Tablas
                </a>
            </li>

            <li>
                <a asp-controller="Surf"
                   asp-action="shapers">
                    Shapers
                </a>
            </li>

            <li>
                <a asp-controller="Surf"
                   asp-action="Dealers">
                    Mapa
                </a>
            </li>
        }

        @if (esShaper)
        {
            <li>
                <a href="#">
                    Dashboard
                </a>
            </li>

            <li>
                <a href="#">
                    Productos
                </a>
            </li>
        }
        

    </ul>

    <div class="nav-actions">

        @* Usuario sin iniciar sesión *@
        @if (!estaLogueado)
        {
            <a asp-controller="Login"
               asp-action="Index"
               class="btn-login"
               id="navLoginBtn">

                <svg width="15"
                     height="15"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">

                    <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
                    <circle cx="12" cy="7" r="4" />

                </svg>

                <span id="navLoginText">
                    Ingresar
                </span>

            </a>
        }
        else
        {
            @* Menú de perfil para cliente y shaper *@
            <div class="profile-dropdown">

                <button type="button"
                        class="profile-button"
                        aria-label="Abrir menú del perfil"
                        aria-expanded="false">

                    <svg width="20"
                         height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M20 21a8 8 0 0 0-16 0"></path>
                        <circle cx="12" cy="7" r="4"></circle>

                    </svg>

                </button>

                <div class="profile-menu">

                    @if (esCliente)
                    {
                        <a href="#">
                            Mis pedidos
                        </a>
                    }

                    <a href="#">
                        Configuración
                    </a>

                    <div class="profile-menu-divider"></div>

                    <a asp-controller="Login"
                       asp-action="Logout"
                       class="logout-link">

                        Salir del perfil

                    </a>

                </div>

            </div>
        }

        @* Carrito solamente para clientes y Visitantes *@
        @if (!esShaper)
        {
            <a asp-controller="Surf"
               asp-action="carrito"
               class="btn-cart-nav"
               id="btnCartNav">

                <svg width="15"
                     height="15"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">

                    <circle cx="9"
                            cy="21"
                            r="1" />

                    <circle cx="20"
                            cy="21"
                            r="1" />

                    <path d="M1 1h4l2.68 13.39a2 2 0 001.99 1.61H19a2 2 0 001.99-1.79L22 7H6" />

                </svg>

                <span>Carrito</span>

                <span class="cart-badge">
                    0
                </span>

            </a>
        }

    </div>

</nav>