@using System.Security.Claims

@{
    bool estaLogueado = User.Identity?.IsAuthenticated ?? false;

    string? rol = estaLogueado
        ? User.FindFirstValue(ClaimTypes.Role)
        : null;

    bool esCliente = string.Equals(
        rol,
        "Cliente",
        StringComparison.OrdinalIgnoreCase
    );

    bool esShaper = string.Equals(
        rol,
        "Shaper",
        StringComparison.OrdinalIgnoreCase
    );
    string? logoUrl = esShaper ? User.FindFirstValue("logo_url") : null;
}

<nav id="navbar">

    <a asp-controller="Surf"
       asp-action="Home"
       class="nav-logo">
        ZEPHYR <span>SURF</span> GO
    </a>

    <ul class="nav-links d-none d-md-flex">

        @* Visitante y cliente *@
        @if (!esShaper)
        {
            <li>
                <a asp-controller="Surf"
                   asp-action="Home">
                    Home
                </a>
            </li>

            <li>
                <a asp-controller="Surf"
                   asp-action="Home"
                   asp-fragment="tablas">
                    Tablas
                </a>
            </li>

            <li>
                <a asp-controller="Surf"
                   asp-action="shapers">
                    Shapers
                </a>
            </li>

            <li>
                <a asp-controller="Surf"
                   asp-action="Dealers">
                    Mapa
                </a>
            </li>
        }

        @if (esShaper)
        {
            <li>
                <a asp-controller="Dashboard"
                   asp-action="Index">
                    Dashboard
                </a>
            </li>

            <li>
                <a asp-controller="Productos"
                   asp-action="Index">
                    Productos
                </a>
            </li>

            <li>
                <a asp-controller="Dashboard"
                   asp-action="Pedidos">
                    Pedidos
                </a>
            </li>

            <li>
                <a asp-controller="SolicitudPersonalizada"
                   asp-action="Solicitudes">
                    Solicitudes custom
                </a>
            </li>

            <li>
                <a asp-controller="Dashboard"
                   asp-action="Facturacion">
                    Facturación
                </a>
            </li>
        }

        

    </ul>

    <div class="nav-actions">

        @* Usuario sin iniciar sesión *@
        @if (!estaLogueado)
        {
            <a asp-controller="Login"
               asp-action="Index"
               class="btn-login"
               id="navLoginBtn">

                <svg width="15"
                     height="15"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">

                    <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
                    <circle cx="12" cy="7" r="4" />

                </svg>

                <span id="navLoginText">
                    Ingresar
                </span>

            </a>
        }
        else
        {
            @* Menú de perfil para cliente y shaper *@
            <div class="profile-dropdown">

                <button type="button"
                        class="profile-button"
                        aria-label="Abrir menú de mi cuenta"
                        aria-expanded="false">

                    @if (!string.IsNullOrWhiteSpace(logoUrl))
                    {
                        <img src="@logoUrl" alt="Logo de mi marca" class="profile-brand-logo" />
                    }
                    else
                    {
                    <svg width="20"
                         height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M20 21a8 8 0 0 0-16 0"></path>
                        <circle cx="12" cy="7" r="4"></circle>

                    </svg>
                    }

                </button>

                <div class="profile-menu">

                    @if (esCliente)
                    {
                        <a asp-controller="MisPedidos" asp-action="Index">
                            Mis pedidos
                        </a>
                        <a asp-controller="SolicitudPersonalizada" asp-action="MisSolicitudes">
                            Mis solicitudes custom
                        </a>
                    }

                    @if (esShaper)
                    {
                        <a asp-controller="Shaper"
                           asp-action="Detalle"
                           asp-route-id="@User.FindFirstValue(ClaimTypes.NameIdentifier)">
                            Ver mi página pública
                        </a>
                    }
                    else if (esCliente)
                    {
                        <a asp-controller="Configuracion"
                           asp-action="Index">
                            Configurar mi cuenta
                        </a>
                    }

                    @if (esShaper)
                    {
                        <a asp-controller="Configuracion"
                           asp-action="Index">
                            Configurar mi cuenta
                        </a>
                    }

                    <div class="profile-menu-divider"></div>

                    <form asp-controller="Login"
                          asp-action="Logout"
                          method="post"
                          class="logout-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="logout-link">
                            Cerrar sesión
                        </button>
                    </form>

                </div>

            </div>
        }

        @* Carrito solamente para clientes y Visitantes *@
        @if (!esShaper)
        {
            <a asp-controller="Carrito"
               asp-action="Index"
               class="btn-cart-nav"
               id="btnCartNav">

                <svg width="15"
                     height="15"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">

                    <circle cx="9"
                            cy="21"
                            r="1" />

                    <circle cx="20"
                            cy="21"
                            r="1" />

                    <path d="M1 1h4l2.68 13.39a2 2 0 001.99 1.61H19a2 2 0 001.99-1.79L22 7H6" />

                </svg>

                <span>Carrito</span>

                <span class="cart-badge">
                    @await Component.InvokeAsync("CarritoCantidad")
                </span>

            </a>
        }

    </div>

</nav>
