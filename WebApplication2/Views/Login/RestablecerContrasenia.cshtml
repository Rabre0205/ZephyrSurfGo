@{Layout=null;ViewData["Title"]="Nueva contraseña";}
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Nueva contraseña — Zephyr</title><link rel="stylesheet" href="~/css/estilosLogin.css"></head><body class="login-page"><div class="auth-wrapper" style="display:grid;place-items:center;min-height:100vh"><div class="auth-card" style="max-width:520px"><div class="form-heading"><h2>Creá una nueva contraseña</h2><p>Usá al menos 8 caracteres y no compartas esta clave.</p></div><div asp-validation-summary="All" class="auth-alert" style="display:block"></div><form method="post"><input type="hidden" name="token" value="@ViewBag.Token"><div class="field"><label>Nueva contraseña</label><div class="field-input-wrap"><input name="nuevaContrasenia" type="password" minlength="8" required autocomplete="new-password"></div></div><div class="field"><label>Confirmar contraseña</label><div class="field-input-wrap"><input name="confirmarContrasenia" type="password" minlength="8" required autocomplete="new-password"></div></div><button class="btn-primary-auth">Guardar contraseña</button></form></div></div></body></html>
