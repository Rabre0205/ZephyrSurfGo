@{Layout=null;ViewData["Title"]="Nueva contraseña";}
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Nueva contraseña — Zephyr Surf Go</title><link rel="stylesheet" href="~/css/editorialSite.css" asp-append-version="true"><link rel="stylesheet" href="~/css/passwordRecovery.css" asp-append-version="true"></head>
<body class="recovery-page"><nav class="recovery-nav"><a asp-controller="Surf" asp-action="Home" class="recovery-logo">ZEPHYR <span>SURF</span> GO</a><a asp-action="Index" class="recovery-back">← Volver al acceso</a></nav><main class="recovery-shell"><section class="recovery-card"><span class="recovery-step">Último paso</span><h1>Nueva<br>contraseña</h1><p class="recovery-lead">Creá una clave de al menos ocho caracteres. Elegí una contraseña que no uses en otros servicios.</p><div asp-validation-summary="All" class="recovery-errors"></div>
<form method="post" class="recovery-form"><input type="hidden" name="token" value="@ViewBag.Token"><div class="recovery-field"><label for="nuevaContrasenia">Nueva contraseña</label><div class="recovery-input"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg><input id="nuevaContrasenia" name="nuevaContrasenia" type="password" minlength="8" required autocomplete="new-password" placeholder="Mínimo 8 caracteres"></div></div><div class="recovery-field"><label for="confirmarContrasenia">Confirmar contraseña</label><div class="recovery-input"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 12 4 4L19 6"/></svg><input id="confirmarContrasenia" name="confirmarContrasenia" type="password" minlength="8" required autocomplete="new-password" placeholder="Repetí la contraseña"></div></div><button class="recovery-button">Guardar nueva contraseña</button></form><p class="recovery-help">Al guardar, el enlace quedará invalidado y podrás iniciar sesión con tu nueva contraseña.</p></section></main></body></html>
