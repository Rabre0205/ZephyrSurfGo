@{Layout=null;ViewData["Title"]="Recuperar contraseña";}
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Recuperar contraseña — Zephyr</title><link rel="stylesheet" href="~/css/estilosLogin.css"><link rel="stylesheet" href="~/css/editorialSite.css"></head><body class="login-page"><div class="auth-wrapper" style="display:grid;place-items:center;min-height:100vh"><div class="auth-card" style="max-width:520px"><div class="form-heading"><h2>Recuperar contraseña</h2><p>Ingresá tu correo y te enviaremos un enlace válido durante 30 minutos.</p></div>@if(ViewBag.Enviado==true){<div class="auth-alert" style="display:block">Si existe una cuenta con ese correo, vas a recibir las instrucciones en unos minutos.</div>}<form method="post"><div class="field"><label for="email">Correo electrónico</label><div class="field-input-wrap"><input id="email" name="email" type="email" required autocomplete="email" placeholder="tu@email.com"></div></div><button class="btn-primary-auth" type="submit">Enviar enlace</button></form><p style="margin-top:24px"><a asp-action="Index">Volver al inicio de sesión</a></p></div></div></body></html>
