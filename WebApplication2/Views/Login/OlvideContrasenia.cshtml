@{Layout=null;ViewData["Title"]="Recuperar contraseña";}
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Recuperar contraseña — Zephyr Surf Go</title><link rel="stylesheet" href="~/css/editorialSite.css" asp-append-version="true"><link rel="stylesheet" href="~/css/passwordRecovery.css" asp-append-version="true"></head>
<body class="recovery-page"><nav class="recovery-nav"><a asp-controller="Surf" asp-action="Home" class="recovery-logo">ZEPHYR <span>SURF</span> GO</a><a asp-action="Index" class="recovery-back">← Volver al acceso</a></nav><main class="recovery-shell"><section class="recovery-card"><span class="recovery-step">Seguridad de tu cuenta</span><h1>Recuperar<br>contraseña</h1><p class="recovery-lead">Ingresá el correo asociado a tu cuenta. Te enviaremos un enlace seguro que podrás utilizar una sola vez durante los próximos 30 minutos.</p>
@if(ViewBag.Enviado==true){<div class="recovery-alert"><span aria-hidden="true">✓</span><span>Si existe una cuenta con ese correo, recibirás las instrucciones en unos minutos. Revisá también la carpeta de correo no deseado.</span></div>}
<form method="post" class="recovery-form"><div class="recovery-field"><label for="email">Correo electrónico</label><div class="recovery-input"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z"/><path d="m4 7 8 6 8-6"/></svg><input id="email" name="email" type="email" required autocomplete="email" placeholder="tu@email.com"></div></div><button class="recovery-button" type="submit">Enviar enlace de recuperación</button></form><p class="recovery-footer"><a asp-action="Index">Recordé mi contraseña</a></p><p class="recovery-help">Por seguridad, no informamos si un correo está registrado. Nunca te pediremos tu contraseña por correo.</p></section></main></body></html>
