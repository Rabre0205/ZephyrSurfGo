@model List<ClassLibrary.Disenos.DisenoShaper>
@{Layout=null;ViewData["Title"]="Diseños";}
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Diseños — Zephyr Surf Go</title><link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="~/css/navbar.css"><link rel="stylesheet" href="~/css/panelOperativo.css"></head><body><partial name="_Navbar"/>
<main class="ops-page"><header class="ops-header"><div><span class="ops-eyebrow">Tu catálogo creativo</span><h1>Diseños de pintura</h1><p>Definí los diseños que tus clientes pueden elegir al personalizar una tabla.</p></div><a class="ops-primary" asp-action="Crear">＋ Agregar diseño</a></header>
@if(TempData["Mensaje"]!=null){<div class="ops-alert">@TempData["Mensaje"]</div>}@if(TempData["Error"]!=null){<div class="ops-alert error">@TempData["Error"]</div>}
@if(Model.Count==0){<div class="ops-empty"><div class="ops-empty-icon">🎨</div><h2>Todavía no agregaste diseños</h2><p>Los clientes seguirán teniendo la opción de pedir un diseño personalizado.</p></div>}
<div class="ops-grid">@foreach(var d in Model){<article class="ops-card">@if(!string.IsNullOrWhiteSpace(d.ImagenUrl)){<img src="@d.ImagenUrl" alt="Ejemplo de @d.Nombre" style="width:100%;height:180px;object-fit:cover;border-radius:12px">}<span class="ops-status @(!d.Activo?"off":"")">@(d.Activo?"Visible":"Oculto")</span><h2>@d.Nombre</h2><p>@(string.IsNullOrWhiteSpace(d.Descripcion)?"Sin descripción":d.Descripcion)</p><p><strong>@d.ZonaAplicacion</strong> · @(d.PermiteColoresPersonalizados?"Colores elegibles":"Colores fijos")<br>Recargo: USD @d.Recargo.ToString("N2")</p><div class="ops-actions"><a class="ops-secondary" asp-action="Editar" asp-route-id="@d.Id">Editar</a><form asp-action="CambiarEstado" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@d.Id"><input type="hidden" name="activo" value="@(!d.Activo)"><button class="@(d.Activo?"ops-danger":"ops-secondary")">@(d.Activo?"Ocultar":"Publicar")</button></form></div></article>}</div></main><script src="~/js/navbar.js"></script></body></html>
