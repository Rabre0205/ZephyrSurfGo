@model ClassLibrary.Disenos.DisenoShaper
@{Layout=null;bool editar=Model.Id>0;ViewData["Title"]=editar?"Editar diseño":"Nuevo diseño";}
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] — Zephyr Surf Go</title><link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="~/css/navbar.css"><link rel="stylesheet" href="~/css/panelOperativo.css"></head><body><partial name="_Navbar"/>
<main class="ops-page"><a class="ops-back" asp-action="Index">← Volver a diseños</a><header class="ops-header"><div><span class="ops-eyebrow">Catálogo creativo</span><h1>@(editar?"Editar diseño":"Nuevo diseño")</h1><p>Mostrá con claridad qué pintura podés realizar y si genera un recargo.</p></div></header>
<form asp-action="Guardar" method="post" enctype="multipart/form-data" class="ops-card">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden"><input asp-for="ImagenUrl" type="hidden"><div asp-validation-summary="All" class="ops-alert error"></div><div class="ops-form-grid">
<label class="ops-field"><span>Nombre</span><input asp-for="Nombre" required maxlength="120" placeholder="Ej.: Líneas retro"></label><label class="ops-field"><span>Zona de aplicación</span><select asp-for="ZonaAplicacion"><option>Ambos</option><option>Deck</option><option>Bottom</option></select></label>
<label class="ops-field ops-wide"><span>Descripción</span><textarea asp-for="Descripcion" maxlength="600" rows="4" placeholder="Explicá cómo se ve y qué incluye"></textarea></label><label class="ops-field"><span>Recargo en USD</span><input asp-for="Recargo" type="number" min="0" max="100000" step="0.01"></label><label class="ops-field"><span>Imagen de ejemplo</span><input name="imagen" type="file" accept="image/jpeg,image/png,image/webp"></label>
<label class="ops-field"><span>Color principal predeterminado</span><input asp-for="ColorPrimario" type="color"></label><label class="ops-field"><span>Color secundario predeterminado</span><input asp-for="ColorSecundario" type="color"></label>
<label class="ops-field ops-wide" style="flex-direction:row;align-items:center"><input asp-for="PermiteColoresPersonalizados" style="width:auto"><span>Permitir que el cliente elija los colores</span></label></div><div class="ops-actions"><button class="ops-primary" type="submit">Guardar diseño</button><a class="ops-secondary" asp-action="Index">Cancelar</a></div></form></main><script src="~/js/navbar.js"></script></body></html>
