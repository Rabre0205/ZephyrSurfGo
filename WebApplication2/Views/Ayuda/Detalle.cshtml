@model ClassLibrary.Soporte.SolicitudSoporte
@{ Layout=null; }
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="~/css/navbar.css"><style>body{background:#f5f6f7}.page{max-width:850px;margin:55px auto;padding:25px}.box{background:white;padding:30px;margin:20px 0;border-radius:10px;white-space:pre-wrap}</style></head><body><partial name="_Navbar"/><main class="page"><a asp-action="Index">← Volver a ayuda</a><h1>@Model.Asunto</h1><p>Estado: <strong>@Model.EstadoNombre</strong></p><section class="box"><h2>Tu mensaje</h2>@Model.Mensaje</section><section class="box"><h2>Respuesta de Zephyr</h2>@(string.IsNullOrWhiteSpace(Model.Respuesta)?"Todavía no respondimos esta consulta.":Model.Respuesta)</section></main><script src="~/js/navbar.js"></script></body></html>
