@model ClassLibrary.Soporte.SolicitudSoporte
@{ Layout=null; }
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="~/css/navbar.css"><link rel="stylesheet" href="~/css/panelOperativo.css"></head><body><partial name="_Navbar"/><main class="ops-page"><a class="ops-back" asp-action="Index">← Volver al centro de ayuda</a><header class="ops-header"><div><span class="ops-eyebrow">Consulta #@Model.Id</span><h1>@Model.Asunto</h1><p>Creada el @Model.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy 'a las' HH:mm")</p></div><span class="ops-status @(Model.Estado==2?"off":"")">@Model.EstadoNombre</span></header><section class="ops-card"><h2>Tu mensaje</h2><p style="white-space:pre-wrap">@Model.Mensaje</p></section><section class="ops-card" style="margin-top:20px"><h2>Respuesta de Zephyr</h2><p style="white-space:pre-wrap">@(string.IsNullOrWhiteSpace(Model.Respuesta)?"Todavía no respondimos esta consulta. Te avisaremos por esta sección cuando haya novedades.":Model.Respuesta)</p></section></main><script src="~/js/navbar.js"></script></body></html>
