@model List<ClassLibrary.Soporte.SolicitudSoporte>
@{ Layout=null; ViewData["Title"]="Ayuda"; }
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ayuda — Zephyr Surf Go</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="~/css/navbar.css"><style>body{background:#f5f6f7;color:#0c1d43}.page{max-width:1050px;margin:50px auto;padding:0 24px}.columns{display:grid;grid-template-columns:1fr 1fr;gap:24px}.box{background:white;padding:28px;border-radius:12px}.box input,.box textarea{width:100%;padding:12px;margin:7px 0 16px;border:1px solid #ccd5dd}.box button{background:#4394e0;color:white;border:0;padding:13px 20px}.ticket{display:block;padding:16px 0;border-bottom:1px solid #ddd;color:inherit;text-decoration:none}.ticket span{float:right}@@media(max-width:750px){.columns{grid-template-columns:1fr}}</style></head><body><partial name="_Navbar"/><main class="page"><h1>Centro de ayuda</h1><p>Contanos qué ocurrió. El equipo administrador recibirá la consulta dentro de Zephyr.</p>
@if(TempData["Mensaje"]!=null){<div class="alert alert-success">@TempData["Mensaje"]</div>}@if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}
<div class="columns"><section class="box"><h2>Nueva consulta</h2><form asp-action="Crear" method="post">@Html.AntiForgeryToken()<label>Asunto<input name="asunto" maxlength="150" required></label><label>¿Cómo podemos ayudarte?<textarea name="mensaje" rows="7" maxlength="2000" required></textarea></label><button>Enviar consulta</button></form></section>
<section class="box"><h2>Mis consultas</h2>@if(Model.Count==0){<p>Todavía no enviaste consultas.</p>}@foreach(var s in Model){<a class="ticket" asp-action="Detalle" asp-route-id="@s.Id"><span>@s.EstadoNombre</span><strong>@s.Asunto</strong><br><small>@s.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></a>}</section></div></main><script src="~/js/navbar.js"></script></body></html>
