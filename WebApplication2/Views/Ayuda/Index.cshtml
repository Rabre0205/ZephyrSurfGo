@model List<ClassLibrary.Soporte.SolicitudSoporte>
@{ Layout=null; ViewData["Title"]="Ayuda"; }
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ayuda — Zephyr Surf Go</title><link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="~/css/navbar.css"><link rel="stylesheet" href="~/css/panelOperativo.css"></head><body><partial name="_Navbar"/><main class="ops-page"><header class="ops-header"><div><span class="ops-eyebrow">Estamos para ayudarte</span><h1>Centro de ayuda</h1><p>Describí lo que ocurrió y seguí la respuesta del equipo de Zephyr desde el mismo lugar.</p></div></header>
@if(TempData["Mensaje"]!=null){<div class="ops-alert">@TempData["Mensaje"]</div>}@if(TempData["Error"]!=null){<div class="ops-alert error">@TempData["Error"]</div>}
<div class="ops-columns"><section class="ops-card"><h2>Nueva consulta</h2><p>Incluí qué estabas intentando hacer y cualquier mensaje de error que hayas visto.</p><form asp-action="Crear" method="post">@Html.AntiForgeryToken()<label class="ops-field">Asunto<input name="asunto" maxlength="150" required placeholder="Ej.: No puedo actualizar un pedido"></label><label class="ops-field">¿Cómo podemos ayudarte?<textarea name="mensaje" rows="7" maxlength="2000" required placeholder="Contanos el problema con el mayor detalle posible..."></textarea></label><button class="ops-primary">Enviar consulta</button></form></section>
<section class="ops-card"><h2>Mis consultas</h2><p>Revisá el estado y las respuestas anteriores.</p>@if(Model.Count==0){<div class="ops-empty"><div class="ops-empty-icon">?</div><h3>Sin consultas</h3><p>Cuando necesites ayuda, tu mensaje aparecerá acá.</p></div>}<div class="ops-list">@foreach(var s in Model){<a class="ops-ticket" asp-action="Detalle" asp-route-id="@s.Id"><span><strong>@s.Asunto</strong><small>@s.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy · HH:mm")</small></span><span class="ops-status @(s.Estado==2?"off":"")">@s.EstadoNombre</span></a>}</div></section></div></main><script src="~/js/navbar.js"></script></body></html>
