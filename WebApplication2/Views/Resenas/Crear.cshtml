@{ Layout = null; }
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Escribir reseña</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"><link rel="stylesheet" href="~/css/navbar.css"></head><body><partial name="_Navbar"/><main class="container py-5" style="margin-top:70px;max-width:650px"><h1>Contá tu experiencia</h1><p class="text-secondary">Tu reseña aparecerá como compra verificada.</p><form method="post" class="border rounded-4 p-4">@Html.AntiForgeryToken()<input type="hidden" name="pedidoId" value="@ViewBag.PedidoId"><input type="hidden" name="productoId" value="@ViewBag.ProductoId"><div asp-validation-summary="All" class="text-danger"></div><fieldset class="mb-3"><legend class="h6">Puntuación</legend><div class="d-flex gap-3">@for(int i=1;i<=5;i++){<label><input type="radio" name="estrellas" value="@i" required> @i ★</label>}</div></fieldset><label class="form-label" for="comentario">Comentario</label><textarea id="comentario" name="comentario" minlength="3" maxlength="1000" required class="form-control" rows="6"></textarea><button class="btn btn-primary mt-3">Publicar reseña</button></form></main><script src="~/js/navbar.js"></script></body></html>
