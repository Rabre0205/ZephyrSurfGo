@model List<ClassLibrary.Interacciones.ResenaProducto>
@{var promedio=Model.Count==0?0:Model.Average(x=>x.Estrellas);}
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Reseñas</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"><link rel="stylesheet" href="~/css/navbar.css"></head><body><partial name="_Navbar"/><main class="container py-5" style="margin-top:70px;max-width:800px"><h1>Reseñas verificadas</h1><p class="fs-4 text-warning">★ @promedio.ToString("0.0") <small class="text-secondary fs-6">(@Model.Count)</small></p>
@if(TempData["Mensaje"]!=null){<div class="alert alert-success">@TempData["Mensaje"]</div>} @if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}
@if(Model.Count==0){<p>Este producto todavía no tiene reseñas.</p>}
@foreach(var r in Model){<article class="border rounded-4 p-4 mb-3"><div class="text-warning">@string.Concat(Enumerable.Repeat("★",r.Estrellas))@string.Concat(Enumerable.Repeat("☆",5-r.Estrellas))</div><p>@r.Comentario</p><small class="text-secondary">@r.ClienteNombre · Compra verificada · @r.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</small>
@if(!string.IsNullOrWhiteSpace(r.RespuestaShaper)){<div class="bg-light p-3 mt-3"><strong>Respuesta de @r.ShaperNombre</strong><p class="mb-0">@r.RespuestaShaper</p></div>}
@if(User.IsInRole("Cliente")&&User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value==r.ClienteId.ToString()){<details class="mt-3"><summary>Editar mi reseña</summary><form asp-action="Editar" method="post" class="mt-2"><input type="hidden" name="id" value="@r.Id"><input type="hidden" name="productoId" value="@r.ProductoId"><input type="number" name="estrellas" min="1" max="5" value="@r.Estrellas" class="form-control mb-2"><textarea name="comentario" maxlength="1000" class="form-control mb-2">@r.Comentario</textarea><button class="btn btn-dark">Guardar</button></form></details>}
@if(User.IsInRole("Shaper")){<form asp-controller="ShaperResenas" asp-action="Responder" method="post" class="mt-3"><input type="hidden" name="id" value="@r.Id"><input type="hidden" name="productoId" value="@r.ProductoId"><textarea name="respuesta" maxlength="1000" placeholder="Responder públicamente" class="form-control mb-2">@r.RespuestaShaper</textarea><button class="btn btn-outline-dark">Publicar respuesta</button></form>}</article>}
</main><script src="~/js/navbar.js"></script></body></html>
