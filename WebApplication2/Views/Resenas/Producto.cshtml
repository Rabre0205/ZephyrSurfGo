@model List<ClassLibrary.Interacciones.ResenaProducto>
@{ Layout = null; double promedio=Model.Count==0?0:Model.Average(r=>r.Estrellas); }
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Reseñas</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"><link rel="stylesheet" href="~/css/navbar.css"></head><body><partial name="_Navbar"/><main class="container py-5" style="margin-top:70px;max-width:800px"><h1>Reseñas verificadas</h1><p class="fs-4 text-warning">★ @promedio.ToString("0.0") <small class="text-secondary fs-6">(@Model.Count)</small></p>@if(Model.Count==0){<p>Este producto todavía no tiene reseñas.</p>}@foreach(var r in Model){<article class="border rounded-4 p-4 mb-3"><div class="text-warning" aria-label="@r.Estrellas de 5 estrellas">@string.Concat(Enumerable.Repeat("★",r.Estrellas))@string.Concat(Enumerable.Repeat("☆",5-r.Estrellas))</div><p class="mb-2">@r.Comentario</p><small class="text-secondary">@r.ClienteNombre · Compra verificada · @r.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</small></article>}</main><script src="~/js/navbar.js"></script></body></html>
