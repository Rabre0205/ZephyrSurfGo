@model IEnumerable<ClassLibrary.Pedidos.PedidoAdminItem>
@{ Layout = null; ViewData["Title"] = "Mis pedidos"; }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Mis pedidos - Zephyr Surf Go</title><link rel="stylesheet" href="~/css/navbar.css"/><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/></head><body><partial name="_Navbar"/><main class="container py-5" style="max-width:1000px;margin-top:70px"><small class="text-uppercase text-primary fw-bold">Tu cuenta</small><h1 class="display-4 fw-bold">Mis pedidos</h1><p class="text-secondary">Consultá tus compras y su estado actual.</p>
@if(!Model.Any()){<section class="border rounded-4 p-5 text-center mt-4"><div class="fs-1">🏄</div><h2>Todavía no realizaste compras</h2><p class="text-secondary">Cuando compres una tabla o accesorio, aparecerá acá.</p><a asp-controller="Surf" asp-action="Home" class="btn btn-primary btn-lg">Ver productos</a></section>}else{<div class="row g-3 mt-3">@foreach(var p in Model){<div class="col-12"><article class="border rounded-4 p-4 d-flex justify-content-between align-items-center flex-wrap gap-3"><div><small class="text-secondary">@p.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</small><h2 class="h4 mb-1">Pedido #@p.Id</h2><p class="mb-0">@(!string.IsNullOrWhiteSpace(p.NegocioShaper)?p.NegocioShaper:p.ShaperNombre)</p></div><div class="text-md-end"><span class="badge text-bg-primary mb-2">@p.EstadoNombre</span><strong class="d-block fs-5">USD @p.Total.ToString("N2")</strong><a asp-action="Detalle" asp-route-id="@p.Id" class="btn btn-outline-primary mt-2">Ver detalle</a></div></article></div>}</div>}</main><script src="~/js/navbar.js"></script></body></html>
