@model WebApplication2.Models.MisPedidos.MisPedidosViewModel
@{ Layout = null; ViewData["Title"] = "Mis pedidos"; }
<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/>
<title>Mis pedidos - Zephyr Surf Go</title><link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true"/><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/></head>
<body><partial name="_Navbar"/><main class="container py-5" style="max-width:1000px;margin-top:70px">
<small class="text-uppercase text-primary fw-bold">Tu cuenta</small><h1 class="display-4 fw-bold">Mis pedidos</h1>
<p class="text-secondary">Consultá en un solo lugar tus compras y las tablas personalizadas encargadas a un shaper.</p>
@if(Model.EstaVacio){
<section class="border rounded-4 p-5 text-center mt-4"><div class="fs-1">🏄</div><h2>Todavía no realizaste pedidos</h2><p class="text-secondary">Cuando compres un producto o encargues una tabla personalizada, aparecerá acá.</p><a asp-controller="Surf" asp-action="Home" class="btn btn-primary btn-lg">Explorar tablas</a></section>
}else{
<div class="row g-3 mt-3">
@foreach(var p in Model.Personalizados){<div class="col-12"><article class="border border-warning rounded-4 p-4 d-flex justify-content-between align-items-center flex-wrap gap-3"><div><span class="badge text-bg-warning mb-2">Tabla personalizada</span><small class="d-block text-secondary">@p.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</small><h2 class="h4 mb-1">Pedido personalizado #@p.Id</h2><p class="mb-0">@p.Modelo · @p.ShaperNombre</p></div><div class="text-md-end"><span class="badge text-bg-primary mb-2">@p.EstadoNombre</span><strong class="d-block fs-6">@(p.PrecioEstimado > 0 ? $"USD {p.PrecioEstimado:N2}" : "Precio a confirmar por el shaper")</strong><a asp-action="DetallePersonalizado" asp-route-id="@p.Id" class="btn btn-outline-primary mt-2">@(p.Estado == 1 ? "Responder cotización" : "Ver configuración")</a></div></article></div>}
@foreach(var p in Model.Compras){<div class="col-12"><article class="border rounded-4 p-4 d-flex justify-content-between align-items-center flex-wrap gap-3"><div><span class="badge text-bg-light mb-2">Compra</span><small class="d-block text-secondary">@p.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</small><h2 class="h4 mb-1">Pedido #@p.Id</h2><p class="mb-0">@(!string.IsNullOrWhiteSpace(p.NegocioShaper)?p.NegocioShaper:p.ShaperNombre)</p></div><div class="text-md-end"><span class="badge text-bg-primary mb-2">@p.EstadoNombre</span><strong class="d-block fs-5">USD @p.Total.ToString("N2")</strong><a asp-action="Detalle" asp-route-id="@p.Id" class="btn btn-outline-primary mt-2">Ver detalle</a></div></article></div>}
</div>}
</main><script src="~/js/navbar.js" asp-append-version="true"></script></body></html>
