@model ClassLibrary.Pedidos.PedidoAdminDetalle
@{ Layout=null; }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Pedido #@Model.Id</title><link rel="stylesheet" href="~/css/navbar.css"/><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/></head><body><partial name="_Navbar"/><main class="container py-5" style="max-width:900px;margin-top:70px"><small class="text-uppercase text-primary fw-bold">Tu compra</small><h1>Pedido #@Model.Id</h1><p class="text-secondary">@Model.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p><div class="row g-3 my-3"><div class="col-md-6"><section class="border rounded-4 p-3 h-100"><small class="text-secondary">Vendedor</small><h2 class="h5">@(!string.IsNullOrWhiteSpace(Model.NegocioShaper)?Model.NegocioShaper:Model.ShaperNombre)</h2></section></div><div class="col-md-6"><section class="border rounded-4 p-3 h-100"><small class="text-secondary">Estado</small><h2 class="h5">@Model.EstadoNombre</h2></section></div></div><section class="border rounded-4 overflow-hidden"><table class="table mb-0"><thead><tr><th>Producto</th><th>Cantidad</th><th>Subtotal</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.TituloSnapshot</td><td>@item.Cantidad</td><td>USD @((item.PrecioUnitarioSnapshot*item.Cantidad).ToString("N2"))</td></tr>}</tbody><tfoot><tr><th colspan="2">Total</th><th>USD @Model.Total.ToString("N2")</th></tr></tfoot></table></section><a asp-action="Index" class="btn btn-link mt-3">← Volver a mis pedidos</a></main><script src="~/js/navbar.js"></script></body></html>
