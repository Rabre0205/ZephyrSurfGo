@model ClassLibrary.Solicitudes.SolicitudPersonalizada
@using System.Text.Json
@{ Layout = null; bool esShaper = User.IsInRole("Shaper"); JsonElement[] accesorios; try { accesorios = JsonSerializer.Deserialize<JsonElement[]>(Model.AccesoriosJson) ?? []; } catch { accesorios = []; } }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/>
<title>Pedido personalizado @Model.Id — Zephyr Surf Go</title><link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/solicitudesPersonalizadas.css" asp-append-version="true"/></head>
<body><partial name="_Navbar"/><main class="requests-page"><a class="back" asp-controller="@(esShaper ? "Dashboard" : "MisPedidos")" asp-action="@(esShaper ? "Pedidos" : "Index")">← Volver a pedidos</a>
@if(TempData["Mensaje"] is string mensaje){<div class="alert alert-success">@mensaje</div>}
@if(TempData["Error"] is string error){<div class="alert alert-danger">@error</div>}
<header class="detail-header"><div><span>Pedido personalizado #@Model.Id</span><h1>@Model.Modelo</h1><p>@(esShaper ? $"Cliente: {Model.ClienteNombre} · {Model.ClienteEmail}" : $"Shaper: {Model.ShaperNombre}")</p></div><span class="status status-@Model.Estado">@Model.EstadoNombre</span></header>
<div class="detail-grid"><section class="detail-card"><h2>Medidas y construcción</h2><dl><dt>Largo</dt><dd>@Model.Largo</dd><dt>Ancho</dt><dd>@Model.Ancho</dd><dt>Grosor</dt><dd>@Model.Grosor</dd><dt>Volumen</dt><dd>@Model.Volumen</dd><dt>Construcción</dt><dd>@Model.Construccion</dd><dt>Tail</dt><dd>@Model.Tail</dd><dt>Quillas</dt><dd>@Model.SistemaQuillas · @Model.ConfiguracionQuillas</dd><dt>Laminado</dt><dd>@Model.Laminado</dd></dl></section>
<section class="detail-card"><h2>Diseño y extras</h2><dl><dt>Diseño</dt><dd>@Model.Diseno</dd><dt>Colores</dt><dd><i class="swatch" style="background:@Model.ColorPrimario"></i><i class="swatch" style="background:@Model.ColorSecundario"></i> @Model.ColorPrimario · @Model.ColorSecundario</dd><dt>Carbono</dt><dd>@Model.ParcheCarbono</dd><dt>Detalles</dt><dd>@(string.IsNullOrEmpty(Model.DetallesAdicionales) ? "Sin detalles adicionales" : Model.DetallesAdicionales)</dd><dt>Accesorios</dt><dd>@(accesorios.Length == 0 ? "Sin accesorios" : string.Join(", ", accesorios.Select(a => a.TryGetProperty("name", out var n) ? n.GetString() : "Accesorio")))</dd><dt>Notas</dt><dd>@(string.IsNullOrEmpty(Model.Notas) ? "Sin notas" : Model.Notas)</dd></dl></section></div>
<section class="price-card"><div><small>Precio del pedido</small><strong>@(Model.PrecioEstimado > 0 ? $"USD {Model.PrecioEstimado:N2}" : "A confirmar por el shaper")</strong><p>El shaper debe revisar la configuración y definir el precio final.</p></div>
@if(esShaper){<div><form asp-action="DefinirPrecio" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><label for="precio"><strong>Definir precio final en USD</strong></label><input id="precio" name="precio" type="number" min="1" max="100000" step="0.01" value="@(Model.PrecioEstimado > 0 ? Model.PrecioEstimado.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "")" required placeholder="Ej.: 750.00"/><button type="submit">Guardar precio</button></form><form asp-action="CambiarEstado" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"/><button class="secondary" name="estado" value="2">Marcar como no disponible</button></form></div>}</section>
</main><script src="~/js/navbar.js" asp-append-version="true"></script></body></html>
