@model IEnumerable<ClassLibrary.Solicitudes.SolicitudPersonalizada>
@{ Layout = null; }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/>
<title>Mis solicitudes — Zephyr Surf Go</title><link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/solicitudesPersonalizadas.css" asp-append-version="true"/></head>
<body><partial name="_Navbar"/><main class="requests-page"><header><span>Tu cuenta</span><h1>Mis solicitudes custom</h1><p>Seguí las tablas personalizadas que enviaste. Una solicitud no es una compra y el precio es estimado.</p></header>
<section class="requests-card">
@if (!Model.Any()) { <div class="empty"><b>No enviaste solicitudes todavía</b><p>Personalizá una tabla desde la página de un shaper.</p></div> }
else { <div class="requests-list">@foreach(var item in Model){<a asp-action="DetalleCliente" asp-route-id="@item.Id" class="request-row"><div><strong>@item.Modelo</strong><small>@item.ShaperNombre · @item.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></div><span class="status status-@item.Estado">@item.EstadoNombre</span><b>USD @item.PrecioEstimado.ToString("N2")</b></a>}</div> }
</section></main><script src="~/js/navbar.js" asp-append-version="true"></script></body></html>
