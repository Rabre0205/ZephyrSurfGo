@model ClassLibrary.PuntosRetiro.PuntoRetiro
@{ Layout=null; bool editar=Model.Id>0; ViewData["Title"]=editar?"Editar punto":"Nuevo punto"; }
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] — Zephyr Surf Go</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"><link rel="stylesheet" href="~/css/navbar.css"><link rel="stylesheet" href="~/css/panelOperativo.css"></head><body><partial name="_Navbar"/>
<main class="ops-page"><a class="ops-back" asp-action="Index">← Volver a puntos de retiro</a><header class="ops-header"><div><span class="ops-eyebrow">Ubicación pública</span><h1>@(editar?"Editar punto":"Nuevo punto")</h1><p>Completá la información que necesitará el cliente para retirar su compra sin confusiones.</p></div></header><div class="privacy-note"><span>🔒</span><div><strong>Protegé la privacidad del taller</strong><br>Marcá solamente un lugar habilitado para recibir clientes.</div></div>
<form asp-action="Guardar" method="post" class="ops-card">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden"><div asp-validation-summary="All" class="ops-alert error"></div><div class="ops-form-grid">
<label class="ops-field"><span>Nombre del punto</span><input asp-for="Nombre" required maxlength="150" placeholder="Ej.: Pick up Pocitos"></label><label class="ops-field"><span>Ciudad</span><input asp-for="Ciudad" required maxlength="120" placeholder="Ej.: Montevideo"></label>
<label class="ops-field ops-wide"><span>Dirección pública</span><input asp-for="Direccion" required maxlength="250" placeholder="Calle, número y referencias necesarias"></label><label class="ops-field ops-wide"><span>Días y horarios</span><input asp-for="Horario" maxlength="250" placeholder="Lunes a viernes, 10:00 a 18:00"></label>
<label class="ops-field ops-wide"><span>Indicaciones para encontrarlo</span><textarea asp-for="Indicaciones" maxlength="500" rows="3" placeholder="Ej.: Ingresar por la puerta lateral"></textarea></label>
<div class="ops-wide"><strong>Ubicación exacta</strong><p>Hacé clic en el mapa para colocar o mover el marcador.</p><div id="pickupMap"></div><input asp-for="Latitud" type="hidden" id="lat"><input asp-for="Longitud" type="hidden" id="lng"><small id="coords"></small></div></div>
<div class="ops-actions"><button class="ops-primary" type="submit">Guardar punto</button><a class="ops-secondary" asp-action="Index">Cancelar</a></div></form></main>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script>const lat=Number(document.getElementById('lat').value.replace(',','.'))||-32.8,lng=Number(document.getElementById('lng').value.replace(',','.'))||-56,map=L.map('pickupMap').setView([lat,lng],@(editar?14:6));L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap'}).addTo(map);let marker=@(editar?"L.marker([lat,lng]).addTo(map)":"null");function setPoint(e){if(marker)marker.setLatLng(e.latlng);else marker=L.marker(e.latlng).addTo(map);document.getElementById('lat').value=e.latlng.lat.toFixed(6);document.getElementById('lng').value=e.latlng.lng.toFixed(6);document.getElementById('coords').textContent=`Ubicación seleccionada: ${e.latlng.lat.toFixed(6)}, ${e.latlng.lng.toFixed(6)}`;}map.on('click',setPoint);</script><script src="~/js/navbar.js"></script></body></html>
