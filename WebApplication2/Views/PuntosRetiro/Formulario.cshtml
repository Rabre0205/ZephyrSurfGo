@model ClassLibrary.PuntosRetiro.PuntoRetiro
@{ Layout=null; bool editar=Model.Id>0; ViewData["Title"]=editar?"Editar punto":"Nuevo punto"; }
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ViewData["Title"] — Zephyr Surf Go</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"><link rel="stylesheet" href="~/css/navbar.css"><style>
body{background:#f5f6f7;color:#0c1d43}.page{max-width:1000px;margin:45px auto;padding:0 24px}.panel{background:white;padding:30px;border-radius:12px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.field{display:flex;flex-direction:column;gap:7px}.field input,.field textarea{padding:12px;border:1px solid #ccd5dd}.wide{grid-column:1/-1}#pickupMap{height:390px;margin-top:10px}.notice{background:#edf6ff;padding:14px;border-left:4px solid #4394e0}.actions{display:flex;gap:12px;margin-top:22px}.actions button{background:#4394e0;color:white;border:0;padding:13px 24px}.actions a{padding:13px;color:#0c1d43}@@media(max-width:700px){.grid{grid-template-columns:1fr}.wide{grid-column:auto}}</style></head><body><partial name="_Navbar"/>
<main class="page"><h1>@(editar?"Editar punto de retiro":"Nuevo punto de retiro")</h1><p class="notice"><strong>Privacidad:</strong> marcá solamente el lugar habilitado para retiros. No ingreses el domicilio privado del taller si no recibe clientes allí.</p>
<form asp-action="Guardar" method="post" class="panel">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden"><div asp-validation-summary="All" class="text-danger"></div><div class="grid">
<label class="field"><span>Nombre del punto</span><input asp-for="Nombre" required maxlength="150" placeholder="Ej.: Pick up Pocitos"></label><label class="field"><span>Ciudad</span><input asp-for="Ciudad" required maxlength="120"></label>
<label class="field wide"><span>Dirección pública</span><input asp-for="Direccion" required maxlength="250"></label><label class="field wide"><span>Días y horarios</span><input asp-for="Horario" maxlength="250" placeholder="Lunes a viernes, 10:00 a 18:00"></label>
<label class="field wide"><span>Indicaciones para encontrarlo</span><textarea asp-for="Indicaciones" maxlength="500" rows="3"></textarea></label>
<div class="wide"><strong>Ubicación exacta</strong><p>Hacé clic en el mapa para colocar o mover el marcador.</p><div id="pickupMap"></div><input asp-for="Latitud" type="hidden" id="lat"><input asp-for="Longitud" type="hidden" id="lng"><small id="coords"></small></div></div>
<div class="actions"><button type="submit">Guardar punto</button><a asp-action="Index">Cancelar</a></div></form></main>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script><script>const lat=Number(document.getElementById('lat').value.replace(',','.'))||-32.8,lng=Number(document.getElementById('lng').value.replace(',','.'))||-56,map=L.map('pickupMap').setView([lat,lng],@(editar?14:6));L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OpenStreetMap'}).addTo(map);let marker=@(editar?"L.marker([lat,lng]).addTo(map)":"null");function setPoint(e){if(marker)marker.setLatLng(e.latlng);else marker=L.marker(e.latlng).addTo(map);document.getElementById('lat').value=e.latlng.lat.toFixed(6);document.getElementById('lng').value=e.latlng.lng.toFixed(6);document.getElementById('coords').textContent=`Ubicación seleccionada: ${e.latlng.lat.toFixed(6)}, ${e.latlng.lng.toFixed(6)}`;}map.on('click',setPoint);</script><script src="~/js/navbar.js"></script></body></html>
