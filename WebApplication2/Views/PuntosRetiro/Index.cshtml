@model List<ClassLibrary.PuntosRetiro.PuntoRetiro>
@{ Layout=null; ViewData["Title"]="Puntos de retiro"; }
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Puntos de retiro — Zephyr Surf Go</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="~/css/navbar.css"><style>
body{background:#f5f6f7;color:#0c1d43}.page{max-width:1100px;margin:55px auto;padding:0 24px}.head{display:flex;justify-content:space-between;align-items:end;margin-bottom:28px}.head h1{font-size:48px}.btn-main{background:#4394e0;color:white;padding:14px 22px;text-decoration:none;border:0}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:18px}.card{padding:24px;border:1px solid #dbe1e6}.badge-on{color:#087a4c}.badge-off{color:#8a4850}.actions{display:flex;gap:10px;margin-top:20px}.actions a,.actions button{padding:9px 13px;border:1px solid #0c1d43;background:white;color:#0c1d43;text-decoration:none}.empty{background:white;padding:50px;text-align:center}.alert{margin-bottom:20px}</style></head><body><partial name="_Navbar"/>
<main class="page"><header class="head"><div><small>TU PERFIL DE SHAPER</small><h1>Puntos de retiro</h1><p>Estos son los únicos lugares que se mostrarán en el mapa público.</p></div><a class="btn-main" asp-action="Crear">+ Agregar punto</a></header>
@if(TempData["Mensaje"]!=null){<div class="alert alert-success">@TempData["Mensaje"]</div>} @if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}
@if(Model.Count==0){<div class="empty"><h2>Todavía no agregaste puntos</h2><p>Agregá un lugar público y seguro donde tus clientes puedan retirar sus compras.</p></div>}
<div class="grid">@foreach(var p in Model){<article class="card"><span class="@(p.Activo?"badge-on":"badge-off")">@(p.Activo?"Visible en el mapa":"Oculto")</span><h2>@p.Nombre</h2><p><strong>@p.Direccion</strong><br>@p.Ciudad</p><p>@p.Horario</p><div class="actions"><a asp-action="Editar" asp-route-id="@p.Id">Editar</a><form asp-action="CambiarEstado" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id"><input type="hidden" name="activo" value="@(!p.Activo)"><button>@(p.Activo?"Ocultar":"Publicar")</button></form></div></article>}</div></main><script src="~/js/navbar.js"></script></body></html>
