@model List<ClassLibrary.PuntosRetiro.PuntoRetiro>
@{ Layout=null; ViewData["Title"]="Puntos de retiro"; }
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Puntos de retiro — Zephyr Surf Go</title><link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="~/css/navbar.css"><link rel="stylesheet" href="~/css/panelOperativo.css"></head><body><partial name="_Navbar"/>
<main class="ops-page"><header class="ops-header"><div><span class="ops-eyebrow">Tu perfil de shaper</span><h1>Puntos de retiro</h1><p>Administrá los lugares públicos y seguros donde tus clientes pueden recibir sus compras. Tu taller privado nunca se muestra automáticamente.</p></div><a class="ops-primary" asp-action="Crear"><span>＋</span> Agregar punto</a></header>
@if(TempData["Mensaje"]!=null){<div class="ops-alert">@TempData["Mensaje"]</div>} @if(TempData["Error"]!=null){<div class="ops-alert error">@TempData["Error"]</div>}
@if(Model.Count==0){<div class="ops-empty"><div class="ops-empty-icon">⌖</div><h2>Todavía no agregaste puntos</h2><p>Creá el primer lugar habilitado para que tus clientes sepan dónde retirar.</p></div>}
<div class="ops-grid">@foreach(var p in Model){<article class="ops-card"><span class="ops-status @(!p.Activo?"off":"")">@(p.Activo?"Visible en el mapa":"Oculto")</span><h2>@p.Nombre</h2><p><strong>@p.Direccion</strong><br>@p.Ciudad</p><p>@(string.IsNullOrWhiteSpace(p.Horario)?"Horario no especificado":p.Horario)</p><div class="ops-actions"><a class="ops-secondary" asp-action="Editar" asp-route-id="@p.Id">Editar datos</a><form asp-action="CambiarEstado" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id"><input type="hidden" name="activo" value="@(!p.Activo)"><button class="@(p.Activo?"ops-danger":"ops-secondary")">@(p.Activo?"Ocultar":"Publicar")</button></form></div></article>}</div></main><script src="~/js/navbar.js"></script></body></html>
