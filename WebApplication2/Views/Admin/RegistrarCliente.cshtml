@using ClassLibrary.Enums
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewBag.Title = "Registrar cliente";

    var paisesSelect = new List<SelectListItem>();

    foreach (Pais p in Enum.GetValues(typeof(Pais)))
    {
        paisesSelect.Add(new SelectListItem
        {
            Text = p.ToString(),
            Value = Convert.ToInt32(p).ToString()
        });
    }
}

<h2>Registrar cliente</h2>

@if (ViewBag.Error != null)
{
    <div class="alert-error">
        @ViewBag.Error
    </div>
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert-success">
        @TempData["Mensaje"]
    </div>
}

<form asp-controller="Admin"
      asp-action="RegistrarCliente"
      method="post">

    @Html.AntiForgeryToken()

    <label for="Nombre">Nombre</label>
    <input id="Nombre"
           name="Nombre"
           type="text"
           required />

    <label for="Email">Email</label>
    <input id="Email"
           name="Email"
           type="email"
           required />

    <label for="Pais">País</label>
    <select id="Pais"
            name="Pais"
            asp-items="paisesSelect"
            required>
        <option value="">Seleccioná un país</option>
    </select>

    <label for="Contrasenia">Contraseña</label>
    <input id="Contrasenia"
           name="Contrasenia"
           type="password"
           required />

    <label for="ConfirmarContrasenia">
        Confirmar contraseña
    </label>

    <input id="ConfirmarContrasenia"
           name="ConfirmarContrasenia"
           type="password"
           required />

    <button type="submit">
        Registrar
    </button>

</form>