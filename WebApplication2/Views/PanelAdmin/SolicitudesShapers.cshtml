@model List<ClassLibrary.Solicitudes.SolicitudShaper>
@{ViewData["Title"]="Solicitudes de shapers";}
<section class="admin-page"><header class="admin-header"><div><span class="admin-eyebrow">Incorporaciones</span><h1>Solicitudes de shapers</h1><p>Revisá postulaciones y registrá cada decisión.</p></div></header><form method="get" class="filters"><input name="busqueda" value="@Context.Request.Query["busqueda"]" placeholder="Nombre, correo o marca"><select name="estado"><option value="">Todos los estados</option>@foreach(var e in new[]{"Pendiente","En revisión","Aprobada","Rechazada"}){<option value="@e">@e</option>}</select><button>Filtrar</button></form>
@if(TempData["Mensaje"]!=null){<p class="alert alert-success">@TempData["Mensaje"]</p>}<div class="admin-table-wrap"><table><thead><tr><th>Solicitante</th><th>Marca</th><th>Experiencia</th><th>Propuesta</th><th>Seguimiento</th></tr></thead><tbody>@foreach(var s in Model){<tr><td><strong>@s.Nombre</strong><br><a href="mailto:@s.Email">@s.Email</a><br>@s.Celular<br>@s.Ubicacion</td><td>@s.Marca<br><small>@s.Instagram</small></td><td>@s.AniosExperiencia años<br>@(s.RealizaPersonalizadas?"Personalizadas":"Estándar") · @(s.RealizaEnvios?"Con envíos":"Sin envíos")</td><td>@s.Presentacion</td><td><form asp-action="ActualizarSolicitudShaper" method="post"><input type="hidden" name="id" value="@s.Id"><select name="estado">@foreach(var e in new[]{"Pendiente","En revisión","Aprobada","Rechazada"}){<option value="@e" selected="@(s.Estado==e)">@e</option>}</select><textarea name="notas" maxlength="1000" placeholder="Notas internas">@s.NotasAdmin</textarea><button>Guardar</button></form></td></tr>}</tbody></table></div></section>
