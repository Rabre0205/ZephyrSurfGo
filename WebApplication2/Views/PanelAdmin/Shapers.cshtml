@model WebApplication2.Models.PanelAdmin.ShapersAdminViewModel

@{
    ViewData["Title"] = "Gestión de shapers";
}

<section class="shapers-page">

    <header class="shapers-header">

        <div>
            <span class="shapers-eyebrow">
                Administración
            </span>

            <h1>Shapers</h1>

            <p>
                Consultá y administrá los fabricantes registrados
                en Zephyr Surf Go.
            </p>
        </div>

        <a asp-controller="PanelAdmin"
           asp-action="RegistrarShaper"
           class="shapers-create-button">
            + Registrar shaper
        </a>

    </header>

    @if (TempData["Mensaje"] != null)
    {
        <div class="shapers-success">
            <strong>Registro completado</strong>

            <span>
                @TempData["Mensaje"]
            </span>
        </div>
    }

    <div class="shapers-toolbar">

        <form asp-controller="PanelAdmin"
              asp-action="Shapers"
              method="get"
              class="shapers-search-form">

            <input type="search"
                   name="busqueda"
                   value="@Model.Busqueda"
                   placeholder="Buscar por nombre, correo, negocio o contacto..." />

            <button type="submit">
                Buscar
            </button>

            @if (!string.IsNullOrWhiteSpace(
                Model.Busqueda))
            {
                <a asp-controller="PanelAdmin"
                   asp-action="Shapers">
                    Limpiar
                </a>
            }

        </form>

        <span class="shapers-results">
            @Model.TotalResultados
            @(Model.TotalResultados == 1
                ? "resultado"
                : "resultados")
        </span>

    </div>

    <div class="shapers-card">

        @if (Model.Shapers == null ||
             !Model.Shapers.Any())
        {
            <div class="shapers-empty">

                <div class="shapers-empty-icon">
                    S
                </div>

                <h2>No hay shapers registrados</h2>

                <p>
                    Registrá el primer fabricante para comenzar
                    a administrar sus productos.
                </p>

                <a asp-controller="PanelAdmin"
                   asp-action="RegistrarShaper">
                    Registrar shaper
                </a>

            </div>
        }
        else
        {
            <div class="shapers-table-wrapper">

                <table class="shapers-table">

                    <thead>
                        <tr>
                            <th>Shaper</th>
                            <th>Correo</th>
                            <th>País</th>
                            <th>Negocio</th>
                            <th>Contacto</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var shaper in Model.Shapers)
                        {
                            <tr>

                                <td>
                                    <div class="shaper-name-cell">

                                        <div class="shaper-avatar">
                                            @(string.IsNullOrWhiteSpace(shaper.Nombre)
                                                ? "S"
                                                : shaper.Nombre.Substring(0, 1).ToUpper())
                                        </div>

                                        <strong>
                                            @shaper.Nombre
                                        </strong>

                                    </div>
                                </td>

                                <td>
                                    @shaper.Email
                                </td>

                                <td>
                                    <span class="shaper-country">
                                        @shaper.Pais
                                    </span>
                                </td>

                                <td>
                                    @shaper.NombreDeNegosio
                                </td>

                                <td>
                                    @shaper.Contacto
                                </td>

                                <td>
                                    @if (shaper.Activo)
                                    {
                                        <span class="status active">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status inactive">
                                            Inactivo
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="shaper-actions">

                                        <a asp-controller="PanelAdmin"
                                           asp-action="EditarShaper"
                                           asp-route-id="@shaper.Id"
                                           class="action-edit">
                                            Editar
                                        </a>

                                        <form asp-controller="PanelAdmin"
                                              asp-action="CambiarEstadoShaper"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@shaper.Id" />

                                            <button type="submit"
                                                    class="@(shaper.Activo
                                                                                                    ? "action-disable"
                                                                                                    : "action-enable")"
                                                    onclick="return confirm('@(shaper.Activo
                                                                                                    ? "¿Seguro que querés desactivar este shaper?"
                                                                                                    : "¿Seguro que querés activar este shaper?")');">

                                                @(shaper.Activo
                                                    ? "Desactivar"
                                                    : "Activar")

                                            </button>

                                        </form>

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

    @if (Model.TotalPaginas > 1)
    {
        <nav class="shapers-pagination"
             aria-label="Paginación de shapers">

            @if (Model.TienePaginaAnterior)
            {
                <a asp-controller="PanelAdmin"
                   asp-action="Shapers"
                   asp-route-busqueda="@Model.Busqueda"
                   asp-route-pagina="@(Model.PaginaActual - 1)">
                    ← Anterior
                </a>
            }
            else
            {
                <span class="disabled">
                    ← Anterior
                </span>
            }

            <span class="page-info">
                Página @Model.PaginaActual
                de @Model.TotalPaginas
            </span>

            @if (Model.TienePaginaSiguiente)
            {
                <a asp-controller="PanelAdmin"
                   asp-action="Shapers"
                   asp-route-busqueda="@Model.Busqueda"
                   asp-route-pagina="@(Model.PaginaActual + 1)">
                    Siguiente →
                </a>
            }
            else
            {
                <span class="disabled">
                    Siguiente →
                </span>
            }

        </nav>
    }

    <a asp-controller="PanelAdmin"
       asp-action="Index"
       class="shapers-back">
        ← Volver al panel
    </a>

</section>

<style>
    .shapers-page {
        width: min(1200px, calc(100% - 40px));
        margin: 0 auto;
        padding: 55px 0 80px;
    }

    .shapers-header {
        display: flex;
        margin-bottom: 32px;
        gap: 28px;
        align-items: flex-end;
        justify-content: space-between;
    }

    .shapers-eyebrow {
        display: block;
        margin-bottom: 8px;
        color: #688076;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .shapers-header h1 {
        margin: 0;
        color: #17231f;
        font-size: clamp(44px, 6vw, 66px);
        line-height: 1;
    }

    .shapers-header p {
        max-width: 600px;
        margin: 14px 0 0;
        color: #68736e;
        line-height: 1.7;
    }

    .shapers-create-button {
        display: inline-flex;
        min-height: 48px;
        padding: 0 22px;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #1d654b;
        color: #ffffff;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 10px 24px rgba(29, 101, 75, 0.20);
        transition: transform 0.2s ease, background 0.2s ease;
    }

        .shapers-create-button:hover {
            transform: translateY(-2px);
            background: #174f3c;
            color: #ffffff;
        }

    .shapers-success {
        display: flex;
        margin-bottom: 20px;
        padding: 16px 18px;
        gap: 5px;
        flex-direction: column;
        border: 1px solid #b8d8ca;
        border-radius: 12px;
        background: #edf7f2;
        color: #17583f;
    }

        .shapers-success span {
            font-size: 14px;
        }

    .shapers-card {
        overflow: hidden;
        border: 1px solid #dce4e0;
        border-radius: 18px;
        background: #ffffff;
        box-shadow: 0 14px 40px rgba(26, 57, 46, 0.07);
    }

    .shapers-table-wrapper {
        overflow-x: auto;
    }

    .shapers-table {
        width: 100%;
        border-collapse: collapse;
    }

        .shapers-table th,
        .shapers-table td {
            padding: 18px 20px;
            border-bottom: 1px solid #edf1ef;
            text-align: left;
            white-space: nowrap;
        }

        .shapers-table th {
            background: #f5f8f6;
            color: #607069;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .shapers-table td {
            color: #4f5b56;
            font-size: 14px;
        }

        .shapers-table tbody tr {
            transition: background 0.2s ease;
        }

            .shapers-table tbody tr:hover {
                background: #f8faf9;
            }

            .shapers-table tbody tr:last-child td {
                border-bottom: 0;
            }

    .shaper-name-cell {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .shaper-avatar {
        display: flex;
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #e8f2ed;
        color: #1d654b;
        font-weight: 800;
    }

    .shaper-name-cell strong {
        color: #18231f;
    }

    .shaper-country {
        display: inline-flex;
        padding: 6px 10px;
        border-radius: 999px;
        background: #eef4f1;
        color: #406354;
        font-size: 12px;
        font-weight: 700;
    }

    .shapers-empty {
        padding: 70px 25px;
        text-align: center;
    }

    .shapers-empty-icon {
        display: flex;
        width: 64px;
        height: 64px;
        margin: 0 auto 20px;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: #eaf3ef;
        color: #1d654b;
        font-size: 24px;
        font-weight: 800;
    }

    .shapers-empty h2 {
        margin: 0 0 10px;
        color: #17231f;
    }

    .shapers-empty p {
        margin: 0 0 22px;
        color: #6b7771;
    }

    .shapers-empty a {
        color: #1d654b;
        font-weight: 700;
    }

    .shapers-back {
        display: inline-block;
        margin-top: 24px;
        color: #1d654b;
        font-weight: 700;
        text-decoration: none;
    }

        .shapers-back:hover {
            text-decoration: underline;
        }

    .action-edit {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 34px;
        padding: 0 14px;
        border-radius: 8px;
        background: #1d654b;
        color: white;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: .2s;
    }

        .action-edit:hover {
            background: #174f3c;
            color: white;
        }

    .status {
        display: inline-flex;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
    }

        .status.active {
            background: #e8f5ee;
            color: #176342;
        }

        .status.inactive {
            background: #f7eaea;
            color: #9b3434;
        }

    .shaper-actions {
        display: flex;
        gap: 8px;
        align-items: center;
    }

        .shaper-actions form {
            margin: 0;
        }

    .action-disable,
    .action-enable {
        min-height: 34px;
        padding: 0 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
    }

    .action-disable {
        border: 1px solid #ebcaca;
        background: #fff5f5;
        color: #a23838;
    }

    .action-enable {
        border: 1px solid #b9d9ca;
        background: #edf8f2;
        color: #176342;
    }

    .shapers-toolbar {
        display: flex;
        margin-bottom: 18px;
        gap: 18px;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
    }

    .shapers-search-form {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }

        .shapers-search-form input {
            width: min(420px, 75vw);
            min-height: 46px;
            padding: 0 15px;
            border: 1px solid #ccd8d2;
            border-radius: 11px;
            outline: none;
        }

            .shapers-search-form input:focus {
                border-color: #1d654b;
                box-shadow: 0 0 0 3px rgba(29, 101, 75, 0.10);
            }

        .shapers-search-form button {
            min-height: 46px;
            padding: 0 18px;
            border: 0;
            border-radius: 10px;
            background: #1d654b;
            color: white;
            font-weight: 700;
            cursor: pointer;
        }

        .shapers-search-form a {
            color: #1d654b;
            font-weight: 700;
            text-decoration: none;
        }

    .shapers-results {
        color: #68736e;
        font-size: 14px;
        font-weight: 700;
    }

    .shapers-pagination {
        display: flex;
        margin-top: 22px;
        gap: 18px;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
    }

        .shapers-pagination a,
        .shapers-pagination .disabled {
            display: inline-flex;
            min-height: 40px;
            padding: 0 15px;
            align-items: center;
            border: 1px solid #d5dfda;
            border-radius: 9px;
            text-decoration: none;
            font-weight: 700;
        }

        .shapers-pagination a {
            background: white;
            color: #1d654b;
        }

            .shapers-pagination a:hover {
                background: #edf5f1;
            }

        .shapers-pagination .disabled {
            background: #f4f5f4;
            color: #a0a8a4;
        }

    .page-info {
        color: #59665f;
        font-size: 14px;
        font-weight: 700;
    }

    @@media (max-width: 700px) {
        .shapers-page {
            width: min(100% - 24px, 1200px);
            padding-top: 35px;
        }

        .shapers-header {
            align-items: stretch;
            flex-direction: column;
        }

        .shapers-create-button {
            width: 100%;
        }
    }
</style>