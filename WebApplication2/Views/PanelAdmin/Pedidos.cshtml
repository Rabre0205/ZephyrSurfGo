@model WebApplication2.Models.PanelAdmin.PedidosAdminViewModel

@{
    ViewData["Title"] = "Gestión de pedidos";
}

<section class="pedidos-page">

    <header class="pedidos-header">
        <div>
            <span class="pedidos-eyebrow">
                Administración
            </span>

            <h1>Pedidos</h1>

            <p>
                Consultá los pedidos registrados en la plataforma.
            </p>
        </div>

        <span class="pedidos-count">
            @Model.TotalResultados
            @(Model.TotalResultados == 1
                ? "pedido"
                : "pedidos")
        </span>
    </header>

    <form asp-action="Pedidos" method="get" class="pedidos-filters">
        <input type="search" name="busqueda" value="@Model.Busqueda"
               placeholder="Buscar por número, cliente o shaper..." />
        <select asp-for="EstadoId">
            <option value="">Todos los estados</option>
            <option value="0">Pendiente</option><option value="1">Aprobado</option>
            <option value="2">Rechazado</option><option value="3">Cancelado</option>
            <option value="4">Completado</option>
        </select>
        <button type="submit">Filtrar</button>
        @if (!string.IsNullOrWhiteSpace(Model.Busqueda) || Model.EstadoId.HasValue)
        { <a asp-action="Pedidos">Limpiar</a> }
    </form>

    <div class="pedidos-card">

        @if (Model.Pedidos == null ||
             !Model.Pedidos.Any())
        {
            <div class="pedidos-empty">
                <div class="pedidos-empty-icon">
                    P
                </div>

                <h2>No hay pedidos registrados</h2>

                <p>
                    Los pedidos aparecerán aquí cuando los clientes
                    realicen compras.
                </p>
            </div>
        }
        else
        {
            <div class="pedidos-table-wrapper">
                <table class="pedidos-table">

                    <thead>
                        <tr>
                            <th>Pedido</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Shaper</th>
                            <th>Estado</th>
                            <th>Total</th>
                            <th>Comisión</th>
                            <th>Detalle</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var pedido in Model.Pedidos)
                        {
                            <tr>
                                <td>
                                    <strong>
                                        #@pedido.Id
                                    </strong>
                                </td>

                                <td>
                                    @pedido.FechaCreacion
                                    .ToLocalTime()
                                    .ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    <div class="pedidos-person">
                                        <strong>
                                            @pedido.ClienteNombre
                                        </strong>

                                        <span>
                                            @pedido.ClienteEmail
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    <div class="pedidos-person">
                                        <strong>
                                            @(string.IsNullOrWhiteSpace(
                                                pedido.NegocioShaper)
                                                ? pedido.ShaperNombre
                                                : pedido.NegocioShaper)
                                        </strong>

                                        @if (!string.IsNullOrWhiteSpace(
                                            pedido.NegocioShaper))
                                        {
                                            <span>
                                                @pedido.ShaperNombre
                                            </span>
                                        }
                                    </div>
                                </td>

                                <td>
                                    <span class="pedido-status
                                        estado-@pedido.EstadoId">

                                        @pedido.EstadoNombre
                                    </span>
                                </td>

                                <td>
                                    <strong>
                                        USD @pedido.Total.ToString("N2")
                                    </strong>
                                </td>

                                <td>
                                    USD
                                    @pedido.ComisionPlataforma
                                    .ToString("N2")
                                </td>
                                <td><a asp-action="DetallePedido" asp-route-id="@pedido.Id" class="detail-link">Ver detalle</a></td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </div>

    @if (Model.TotalPaginas > 1)
    {
        <nav class="pedidos-pagination"
             aria-label="Paginación de pedidos">

            @if (Model.TienePaginaAnterior)
            {
                <a asp-controller="PanelAdmin"
                   asp-action="Pedidos"
                   asp-route-busqueda="@Model.Busqueda"
                   asp-route-estadoId="@Model.EstadoId"
                   asp-route-pagina="@(Model.PaginaActual - 1)">
                    ← Anterior
                </a>
            }
            else
            {
                <span class="disabled">
                    ← Anterior
                </span>
            }

            <span class="page-info">
                Página @Model.PaginaActual
                de @Model.TotalPaginas
            </span>

            @if (Model.TienePaginaSiguiente)
            {
                <a asp-controller="PanelAdmin"
                   asp-action="Pedidos"
                   asp-route-busqueda="@Model.Busqueda"
                   asp-route-estadoId="@Model.EstadoId"
                   asp-route-pagina="@(Model.PaginaActual + 1)">
                    Siguiente →
                </a>
            }
            else
            {
                <span class="disabled">
                    Siguiente →
                </span>
            }

        </nav>
    }

    <a asp-controller="PanelAdmin"
       asp-action="Index"
       class="pedidos-back">
        ← Volver al panel
    </a>

</section>

<style>
    .pedidos-page {
        width: min(1250px, calc(100% - 40px));
        margin: 0 auto;
        padding: 55px 0 80px;
    }

    .pedidos-header {
        display: flex;
        margin-bottom: 32px;
        gap: 24px;
        align-items: flex-end;
        justify-content: space-between;
    }

    .pedidos-eyebrow {
        display: block;
        margin-bottom: 8px;
        color: #688076;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .pedidos-header h1 {
        margin: 0;
        color: #17231f;
        font-size: clamp(42px, 6vw, 68px);
        line-height: 1;
    }

    .pedidos-header p {
        margin: 14px 0 0;
        color: #68736e;
    }

    .pedidos-count {
        padding: 10px 16px;
        border-radius: 999px;
        background: #eaf3ef;
        color: #1c684c;
        font-weight: 700;
    }

    .pedidos-filters { display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px; }
    .pedidos-filters input { flex:1 1 320px; }
    .pedidos-filters input,.pedidos-filters select { padding:12px 14px;border:1px solid #d6dfdb;border-radius:10px;background:white; }
    .pedidos-filters button,.pedidos-filters a { padding:12px 18px;border:0;border-radius:10px;font-weight:700;text-decoration:none; }
    .pedidos-filters button { background:#1c684c;color:white; }.pedidos-filters a { background:#eaf3ef;color:#1c684c; }
    .detail-link { color:#1c684c;font-weight:700;text-decoration:none;white-space:nowrap; }

    .pedidos-card {
        overflow: hidden;
        border: 1px solid #dce4e0;
        border-radius: 18px;
        background: #ffffff;
        box-shadow: 0 12px 35px rgba(26, 57, 46, 0.07);
    }

    .pedidos-table-wrapper {
        overflow-x: auto;
    }

    .pedidos-table {
        width: 100%;
        border-collapse: collapse;
    }

    .pedidos-table th,
    .pedidos-table td {
        padding: 17px 18px;
        border-bottom: 1px solid #edf1ef;
        text-align: left;
        vertical-align: middle;
    }

    .pedidos-table th {
        background: #f6f9f7;
        color: #63706a;
        font-size: 12px;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .pedidos-table tbody tr:hover {
        background: #fafcfb;
    }

    .pedidos-person {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .pedidos-person span {
        color: #77817c;
        font-size: 13px;
    }

    .pedido-status {
        display: inline-flex;
        padding: 7px 11px;
        border-radius: 999px;
        background: #edf1ef;
        color: #56615c;
        font-size: 12px;
        font-weight: 700;
    }

    .pedido-status.estado-0 {
        background: #fff3cd;
        color: #806000;
    }

    .pedido-status.estado-1 {
        background: #d9f3e5;
        color: #17633f;
    }

    .pedido-status.estado-2,
    .pedido-status.estado-3 {
        background: #fde1e1;
        color: #9e2e2e;
    }

    .pedido-status.estado-4 {
        background: #dcecff;
        color: #245a92;
    }

    .pedidos-empty {
        padding: 70px 25px;
        text-align: center;
    }

    .pedidos-empty-icon {
        display: flex;
        width: 58px;
        height: 58px;
        margin: 0 auto 18px;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: #eaf3ef;
        color: #1c684c;
        font-size: 21px;
        font-weight: 800;
    }

    .pedidos-empty h2 {
        margin: 0 0 8px;
        color: #17231f;
    }

    .pedidos-empty p {
        margin: 0;
        color: #707b76;
    }

    .pedidos-pagination {
        display: flex;
        margin-top: 24px;
        gap: 18px;
        align-items: center;
        justify-content: center;
    }

    .pedidos-pagination a,
    .pedidos-pagination span {
        padding: 10px 14px;
    }

    .pedidos-pagination a {
        border-radius: 10px;
        background: #1c684c;
        color: white;
        font-weight: 700;
        text-decoration: none;
    }

    .pedidos-pagination .disabled {
        color: #a7afab;
    }

    .page-info {
        color: #65716b;
        font-weight: 600;
    }

    .pedidos-back {
        display: inline-block;
        margin-top: 28px;
        color: #1c684c;
        font-weight: 700;
        text-decoration: none;
    }

    @@media (max-width: 720px) {
        .pedidos-page {
            width: min(100% - 24px, 1250px);
            padding-top: 35px;
        }

        .pedidos-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .pedidos-pagination {
            gap: 6px;
        }

        .pedidos-pagination a,
        .pedidos-pagination span {
            padding: 9px 8px;
            font-size: 13px;
        }
    }
</style>
