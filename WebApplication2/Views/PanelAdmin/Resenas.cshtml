@model List<ClassLibrary.Interacciones.ResenaProducto>
@{ViewData["Title"]="Moderación de reseñas";}
<section class="admin-page"><header class="admin-header"><div><span class="admin-eyebrow">Comunidad</span><h1>Reseñas</h1><p>Moderá contenido sin eliminar el historial de compras verificadas.</p></div></header>
<form method="get" class="filters"><input name="busqueda" value="@Context.Request.Query["busqueda"]" placeholder="Cliente, producto o comentario"><select name="estado"><option value="">Todas</option><option value="visibles">Visibles</option><option value="ocultas">Ocultas</option></select><button>Filtrar</button></form>
@if(TempData["Mensaje"]!=null){<p class="alert alert-success">@TempData["Mensaje"]</p>}<div class="admin-table-wrap"><table><thead><tr><th>Producto</th><th>Cliente</th><th>Reseña</th><th>Estado</th><th>Acción</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.ProductoTitulo<br><small>@r.ShaperNombre</small></td><td>@r.ClienteNombre</td><td><strong>@r.Estrellas/5</strong><br>@r.Comentario</td><td>@(r.Moderada?"Oculta":"Visible")</td><td><form asp-action="ModerarResena" method="post"><input type="hidden" name="id" value="@r.Id"><input type="hidden" name="ocultar" value="@(!r.Moderada)">@if(!r.Moderada){<input name="motivo" required maxlength="300" placeholder="Motivo de moderación">}<button>@(r.Moderada?"Republicar":"Ocultar")</button></form></td></tr>}</tbody></table></div></section>
