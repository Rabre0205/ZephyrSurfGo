@{
    ViewData["Title"] = "Panel administrador";
}

<section class="admin-page">

    <header class="admin-header">
        <div>
            <span class="admin-eyebrow">Administración</span>
            <h1>Panel general</h1>
            <p>
                Gestioná los shapers, productos, pedidos y ventas
                de Zephyr Surf Go.
            </p>
        </div>
    </header>

    <section class="admin-stats">

        <article class="admin-stat-card">
            <span class="admin-stat-label">Shapers registrados</span>
            <strong>@ViewBag.CantidadShapers</strong>

            <a asp-controller="PanelAdmin"
               asp-action="Shapers">
                Gestionar shapers
            </a>
        </article>

        <article class="admin-stat-card">
            <span class="admin-stat-label">Productos publicados</span>
            <strong>0</strong>

            <a asp-controller="PanelAdmin"
               asp-action="Productos">
                Gestionar productos
            </a>
        </article>

        <article class="admin-stat-card">
            <span class="admin-stat-label">Pedidos realizados</span>
            <strong>0</strong>

            <a asp-controller="PanelAdmin"
               asp-action="Pedidos">
                Ver pedidos
            </a>
        </article>

        <article class="admin-stat-card">
            <span class="admin-stat-label">Ventas totales</span>
            <strong>USD 0</strong>

            <a asp-controller="PanelAdmin"
               asp-action="Estadisticas">
                Ver estadísticas
            </a>
        </article>

    </section>

    <section class="admin-tools">

        <div class="admin-section-heading">
            <span>Accesos rápidos</span>
            <h2>Administración de la plataforma</h2>
        </div>

        <div class="admin-tools-grid">

            <a asp-controller="PanelAdmin"
               asp-action="Shapers"
               class="admin-tool-card">

                <div class="admin-tool-icon">S</div>

                <div>
                    <h3>Gestionar shapers</h3>
                    <p>
                        Consultá, registrá y administrá las cuentas
                        de los fabricantes.
                    </p>
                </div>
            </a>

            <a asp-controller="PanelAdmin"
               asp-action="Productos"
               class="admin-tool-card">

                <div class="admin-tool-icon">P</div>

                <div>
                    <h3>Gestionar productos</h3>
                    <p>
                        Revisá las tablas y productos publicados
                        en la plataforma.
                    </p>
                </div>
            </a>

            <a asp-controller="PanelAdmin"
               asp-action="Pedidos"
               class="admin-tool-card">

                <div class="admin-tool-icon">O</div>

                <div>
                    <h3>Ver pedidos</h3>
                    <p>
                        Accedé al estado y detalle de todos
                        los pedidos realizados.
                    </p>
                </div>
            </a>

            <a asp-controller="PanelAdmin"
               asp-action="Estadisticas"
               class="admin-tool-card">

                <div class="admin-tool-icon">E</div>

                <div>
                    <h3>Estadísticas</h3>
                    <p>
                        Consultá ventas, comisiones y actividad
                        general de la plataforma.
                    </p>
                </div>
            </a>

        </div>

    </section>

</section>

<style>
    .admin-page {
        width: min(1200px, calc(100% - 40px));
        margin: 0 auto;
        padding: 55px 0 80px;
    }

    .admin-header {
        margin-bottom: 36px;
    }

    .admin-eyebrow {
        display: block;
        margin-bottom: 8px;
        color: #688076;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .admin-header h1 {
        margin: 0;
        color: #17231f;
        font-size: clamp(42px, 6vw, 68px);
        line-height: 1;
    }

    .admin-header p {
        max-width: 620px;
        margin: 14px 0 0;
        color: #68736e;
        font-size: 16px;
        line-height: 1.7;
    }

    .admin-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
    }

    .admin-stat-card {
        display: flex;
        min-height: 190px;
        padding: 24px;
        flex-direction: column;
        border: 1px solid #dce4e0;
        border-radius: 18px;
        background: #ffffff;
        box-shadow: 0 12px 35px rgba(26, 57, 46, 0.07);
    }

    .admin-stat-label {
        color: #68756f;
        font-size: 14px;
    }

    .admin-stat-card strong {
        margin: 18px 0;
        color: #17231f;
        font-size: 40px;
        line-height: 1;
    }

    .admin-stat-card a {
        margin-top: auto;
        color: #1c684c;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
    }

        .admin-stat-card a:hover {
            text-decoration: underline;
        }

    .admin-tools {
        margin-top: 55px;
    }

    .admin-section-heading span {
        color: #708078;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .admin-section-heading h2 {
        margin: 8px 0 24px;
        color: #17231f;
        font-size: 30px;
    }

    .admin-tools-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .admin-tool-card {
        display: flex;
        min-height: 150px;
        padding: 24px;
        gap: 18px;
        align-items: flex-start;
        border: 1px solid #dce4e0;
        border-radius: 18px;
        background: #ffffff;
        color: inherit;
        text-decoration: none;
        box-shadow: 0 10px 28px rgba(26, 57, 46, 0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

        .admin-tool-card:hover {
            transform: translateY(-3px);
            border-color: #b8cec4;
            box-shadow: 0 18px 40px rgba(26, 57, 46, 0.10);
        }

    .admin-tool-icon {
        display: flex;
        width: 50px;
        height: 50px;
        flex: 0 0 50px;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #eaf3ef;
        color: #1c684c;
        font-size: 18px;
        font-weight: 800;
    }

    .admin-tool-card h3 {
        margin: 0 0 8px;
        color: #17231f;
        font-size: 19px;
    }

    .admin-tool-card p {
        margin: 0;
        color: #6c7772;
        font-size: 14px;
        line-height: 1.6;
    }

    @@media (max-width: 950px) {
        .admin-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 720px) {
        .admin-page {
            width: min(100% - 24px, 1200px);
            padding-top: 35px;
        }

        .admin-tools-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 520px) {
        .admin-stats {
            grid-template-columns: 1fr;
        }
    }
</style>