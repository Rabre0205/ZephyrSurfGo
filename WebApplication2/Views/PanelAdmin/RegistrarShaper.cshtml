@model WebApplication2.Models.PanelAdmin.RegistrarShaperViewModel

@using ClassLibrary.Enums

@{
    ViewData["Title"] = "Registrar shaper";
}

<section class="register-shaper-page">

    <div class="register-shaper-card">

        <header class="register-shaper-header">

            <span>
                Administración
            </span>

            <h1>Registrar shaper</h1>

            <p>
                Creá las credenciales iniciales para un fabricante
                previamente aprobado por Zephyr Surf Go.
            </p>

        </header>

        <form asp-controller="PanelAdmin"
              asp-action="RegistrarShaper"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="register-shaper-errors">
            </div>

            <div class="register-shaper-grid">

                <div class="register-shaper-field">

                    <label asp-for="Nombre"></label>

                    <input asp-for="Nombre"
                           placeholder="Nombre del responsable" />

                    <span asp-validation-for="Nombre"></span>

                </div>

                <div class="register-shaper-field">

                    <label asp-for="Email"></label>

                    <input asp-for="Email"
                           type="email"
                           placeholder="correo@ejemplo.com" />

                    <span asp-validation-for="Email"></span>

                </div>

                <div class="register-shaper-field">

                    <label asp-for="Pais"></label>

                    <select asp-for="Pais"
                            asp-items="Html.GetEnumSelectList<Pais>()">
                    </select>

                    <span asp-validation-for="Pais"></span>

                </div>

                <div class="register-shaper-field">

                    <label asp-for="NombreDeNegosio"></label>

                    <input asp-for="NombreDeNegosio"
                           placeholder="Nombre de la marca" />

                    <span asp-validation-for="NombreDeNegosio"></span>

                </div>

                <div class="register-shaper-field full-width">

                    <label asp-for="Contacto"></label>

                    <input asp-for="Contacto"
                           placeholder="Teléfono, WhatsApp u otro contacto" />

                    <span asp-validation-for="Contacto"></span>

                </div>

                <div class="register-shaper-field">

                    <label asp-for="Contrasenia"></label>

                    <input asp-for="Contrasenia"
                           type="password"
                           placeholder="Mínimo 6 caracteres" />

                    <span asp-validation-for="Contrasenia"></span>

                </div>

                <div class="register-shaper-field">

                    <label asp-for="ConfirmarContrasenia"></label>

                    <input asp-for="ConfirmarContrasenia"
                           type="password"
                           placeholder="Repetí la contraseña" />

                    <span asp-validation-for="ConfirmarContrasenia"></span>

                </div>

            </div>

            <div class="register-shaper-actions">

                <a asp-controller="PanelAdmin"
                   asp-action="Shapers">
                    Cancelar
                </a>

                <button type="submit">
                    Registrar shaper
                </button>

            </div>

        </form>

    </div>

</section>

<style>
    .register-shaper-page {
        display: flex;
        min-height: calc(100vh - 170px);
        padding: 55px 20px;
        align-items: center;
        justify-content: center;
        background: radial-gradient( circle at top left, rgba(33, 112, 87, 0.08), transparent 35% ), #f4f7f5;
    }

    .register-shaper-card {
        width: min(100%, 850px);
        padding: 44px;
        border: 1px solid #dce4e0;
        border-radius: 22px;
        background: #ffffff;
        box-shadow: 0 18px 55px rgba(26, 57, 46, 0.09);
    }

    .register-shaper-header span {
        color: #688076;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
    }

    .register-shaper-header h1 {
        margin: 8px 0 10px;
        color: #17231f;
        font-size: clamp(38px, 5vw, 50px);
    }

    .register-shaper-header p {
        max-width: 600px;
        margin: 0 0 32px;
        color: #69756f;
        line-height: 1.7;
    }

    .register-shaper-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .register-shaper-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .register-shaper-field.full-width {
            grid-column: 1 / -1;
        }

        .register-shaper-field label {
            color: #27332e;
            font-size: 14px;
            font-weight: 700;
        }

        .register-shaper-field input,
        .register-shaper-field select {
            width: 100%;
            min-height: 48px;
            padding: 0 14px;
            border: 1px solid #ccd8d2;
            border-radius: 10px;
            background: #ffffff;
            color: #26312d;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

            .register-shaper-field input:focus,
            .register-shaper-field select:focus {
                border-color: #1d654b;
                box-shadow: 0 0 0 3px rgba(29, 101, 75, 0.10);
            }

        .register-shaper-field span,
        .register-shaper-errors {
            color: #b53a3a;
            font-size: 13px;
        }

    .register-shaper-actions {
        display: flex;
        margin-top: 32px;
        gap: 14px;
        align-items: center;
        justify-content: flex-end;
    }

        .register-shaper-actions a,
        .register-shaper-actions button {
            display: inline-flex;
            min-height: 46px;
            padding: 0 22px;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            font-family: inherit;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            transition: transform 0.2s ease, background 0.2s ease;
        }

        .register-shaper-actions a {
            border: 1px solid #d4ddd8;
            background: #ffffff;
            color: #34423c;
        }

            .register-shaper-actions a:hover {
                background: #f2f5f3;
            }

        .register-shaper-actions button {
            border: 0;
            background: #1d654b;
            color: #ffffff;
            cursor: pointer;
            box-shadow: 0 10px 22px rgba(29, 101, 75, 0.18);
        }

            .register-shaper-actions button:hover {
                transform: translateY(-2px);
                background: #174f3c;
            }

    @@media (max-width: 650px) {
        .register-shaper-page {
            padding: 30px 14px;
        }

        .register-shaper-card {
            padding: 30px 22px;
        }

        .register-shaper-grid {
            grid-template-columns: 1fr;
        }

        .register-shaper-field.full-width {
            grid-column: auto;
        }

        .register-shaper-actions {
            align-items: stretch;
            flex-direction: column-reverse;
        }

            .register-shaper-actions a,
            .register-shaper-actions button {
                width: 100%;
            }
    }
</style>