            </div>

        </section>

        <!-- ═══════════════════════════════════════════════════════
         CUSTOM ORDER SUMMARY
    ════════════════════════════════════════════════════════ -->
        <section class="custom-order-summary">

            <h3>Custom Order Summary</h3>

            <div class="custom-summary-row">
                <span id="summaryBoardName">
                    Master El Gaucho
                </span>

                <span id="summaryBoardPrice">
                    USD 780
                </span>
            </div>

            <div class="custom-summary-row">
                <span id="summaryFinSetup">
                    Fin Setup (Thruster)
                </span>

                <span id="summaryFinPrice">
                    USD 25
                </span>
            </div>

            <div class="custom-summary-accessories"
                 id="summaryAccessories">
            </div>

            <div class="custom-summary-row custom-summary-total">
                <span>Total</span>

                <span id="summaryTotal">
                    USD 805
                </span>
            </div>

            <button type="button"
                    class="custom-add-cart-button"
                    onclick="addCustomToCart()">
                Add to cart
            </button>

        </section>

    </section>

    <div class="section-divider"></div>

    <!-- ── CTA CARRITO ── -->
    <section id="compra" style="padding:5rem 3rem;text-align:center;background:var(--master-mid);position:relative;">
        <div style="position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(201,168,76,.25),transparent);"></div>
        <div class="reveal" style="max-width:560px;margin:0 auto;">
            <p style="font-size:.68rem;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);font-weight:500;margin-bottom:.75rem;">Último paso</p>
            <h2 style="font-family:'Bebas Neue',sans-serif;font-size:clamp(2.5rem,5vw,4.5rem);color:#fff;line-height:1;margin-bottom:1rem;">Listo para pedir?</h2>
            <p style="font-size:.95rem;color:rgba(255,255,255,.4);line-height:1.8;font-weight:300;margin-bottom:2.5rem;">Revisá tu selección y completá tus datos de surf. @Model.Shaper.Nombre podrá comunicarse contigo para cerrar los detalles.</p>
            <a asp-controller="Carrito"
               asp-action="Index"
               class="btn-gold"
               style="display:inline-block;
                padding:1.1rem 3rem;
                font-size:.92rem;
                letter-spacing:.1em;
                text-transform:uppercase;
                font-weight:700;
                text-decoration:none;">

                Ir al carrito y confirmar pedido →

            </a>
            <p style="font-size:.72rem;color:rgba(255,255,255,.2);margin-top:1.5rem;letter-spacing:.04em;">Cada tabla se hace a mano, a tu medida.</p>
        </div>
    </section>

  
    <!-- ── TOAST ── -->
    <div class="zsg-toast-container" id="toastContainer"></div>

    <!-- ── FOOTER ── -->
    <footer>
        <div class="footer-inner">
            <div>
                <div class="footer-logo">
                    ZEPHYR <span>SURF</span> GO
                    <span class="master-tag">
                        × @nombreNegocio
                    </span>
                </div>
                <div class="footer-tagline">Tablas de autor. Olas uruguayas.</div>
            </div>
            <ul class="footer-links">
                <li><a href="index.html">Inicio</a></li>
                <li>
                    <a href="#tablas">
                        Catálogo de @nombreNegocio
                    </a>
                </li>
                <li><a href="#recomendador">Recomendador</a></li>
                <li><a href="#customizador">Customizador</a></li>
                <li><a href="index2.html">Dealers</a></li>
            </ul>
            <div style="font-size:.75rem;letter-spacing:.08em;">
                <p style="color:rgba(255,255,255,.25);text-transform:uppercase;letter-spacing:.12em;font-size:.65rem;margin-bottom:.6rem;">Contacto</p>
                <p>@pais</p>

                @if (!string.IsNullOrWhiteSpace(contacto))
                {
                    <p style="margin-top:.35rem;color:var(--gold);">
                        @contacto
                    </p>
                }
                <p style="margin-top:.35rem;color:var(--gold);"></p>
            </div>
        </div>
        <p class="footer-copy">
            © 2026 @nombreNegocio · Zephyr Surf Go —
            Todos los derechos reservados.
        </p>
    </footer>

    <script>
        window.shaperPageData = {
            shaperId: @Model.Shaper.Id,
            shaperName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(nombreNegocio)),
            cartAddUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("Agregar", "Carrito"))),
            cartUrl: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Url.Action("Index", "Carrito"))),
            boards: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Tablas.Select(tabla => new
            {
                key = $"producto-{tabla.Id}",
                name = tabla.Titulo,
                cat = $"{tabla.Subtitulo} · {tabla.EstiloDeSurf}",
                spec = $"{tabla.Altura} · {tabla.Volumen:0.#}L · {tabla.SistemaDeEncaje}",
                vol = tabla.Volumen,
                price = tabla.Precio,
                experience = tabla.Experiencia.ToString(),
                wave = tabla.TipoDeOla.ToString(),
                style = tabla.EstiloDeSurf.ToString(),
                weightMin = tabla.PesoMinimo,
                weightMax = tabla.PesoMaximo,
                description = tabla.Descripcion,
                frontImage = tabla.ImagenUrl,
                backImage = tabla.ImagenAtrasUrl,
                finSystem = tabla.SistemaDeEncaje.ToString()
            })))
        };

        const legacyModels = document.getElementById('legacyDemoModels');
        if (legacyModels && window.shaperPageData.boards.length > 0) legacyModels.remove();
        document.getElementById('legacyAccessories')?.remove();
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/Master.js" asp-append-version="true"></script>
    <script src="~/js/navbar.js" asp-append-version="true"></script>
</body>
</html>
