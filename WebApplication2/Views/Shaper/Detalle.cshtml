        <section class="custom-accessories-section" id="dynamicAccessories">
            <p class="section-eyebrow">Accesorios compatibles</p>
            <h3 class="custom-accessories-title">Completá tu tabla</h3>
            <div class="accessory-tabs">
                <button type="button" class="accessory-tab active" data-accessory-tab="fins" onclick="changeAccessoryTab('fins')">Quillas</button>
                <button type="button" class="accessory-tab" data-accessory-tab="leash" onclick="changeAccessoryTab('leash')">Leash</button>
                <button type="button" class="accessory-tab" data-accessory-tab="pads" onclick="changeAccessoryTab('pads')">Pads</button>
            </div>
            <div class="accessory-content">
                <div class="accessory-panel active" id="accessoryFins">
                    <div class="accessory-products-grid">
                        @foreach (var quilla in Model.Quillas)
                        {
                            <article class="accessory-product" data-accessory-id="producto-@quilla.Id"
                                     data-accessory-name="@quilla.Titulo"
                                     data-accessory-price="@quilla.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                     data-accessory-type="fin"
                                     data-accessory-image="@quilla.ImagenUrl"
                                     data-fin-system="@quilla.SistemaDeEncaje"
                                     onclick="selectAccessory(this)">
                                <img src="@(string.IsNullOrWhiteSpace(quilla.ImagenUrl) ? Url.Content("~/img/tabla.png") : quilla.ImagenUrl)" alt="@quilla.Titulo" />
                                <h4>@quilla.Titulo</h4>
                                <p>@quilla.SistemaDeEncaje · @quilla.Descripcion</p>
                                <strong>USD @quilla.Precio.ToString("N2")</strong>
                            </article>
                        }
                        @if (Model.Quillas.Count == 0) { <p>No hay quillas publicadas por este shaper.</p> }
                    </div>
                </div>
                <div class="accessory-panel" id="accessoryLeash">
                    <div class="accessory-products-grid">
                        @foreach (var leash in Model.Leashes)
                        {
                            <article class="accessory-product" data-accessory-id="producto-@leash.Id"
                                     data-accessory-name="@leash.Titulo"
                                     data-accessory-price="@leash.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                     data-accessory-type="leash"
                                     data-accessory-image="@leash.ImagenUrl"
                                     onclick="selectAccessory(this)">
                                <img src="@(string.IsNullOrWhiteSpace(leash.ImagenUrl) ? Url.Content("~/img/tabla.png") : leash.ImagenUrl)" alt="@leash.Titulo" />
                                <h4>@leash.Titulo</h4>
                                <p>Recomendado hasta @leash.LargoDeTablaRecomendado pies · @leash.Descripcion</p>
                                <strong>USD @leash.Precio.ToString("N2")</strong>
                            </article>
                        }
                        @if (Model.Leashes.Count == 0) { <p>No hay leash publicados por este shaper.</p> }
                    </div>
                </div>
                <div class="accessory-panel" id="accessoryPads">
                    <div class="accessory-products-grid">
                        @foreach (var pad in Model.Pads)
                        {
                            <article class="accessory-product" data-accessory-id="producto-@pad.Id"
                                     data-accessory-name="@pad.Titulo"
                                     data-accessory-price="@pad.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                     data-accessory-type="pad"
                                     data-accessory-image="@pad.ImagenUrl"
                                     onclick="selectAccessory(this)">
                                <img src="@(string.IsNullOrWhiteSpace(pad.ImagenUrl) ? Url.Content("~/img/tabla.png") : pad.ImagenUrl)" alt="@pad.Titulo" />
                                <h4>@pad.Titulo</h4>
                                <p>@pad.Largo × @pad.Ancho · @pad.Material</p>
                                <strong>USD @pad.Precio.ToString("N2")</strong>
                            </article>
                        }
                        @if (Model.Pads.Count == 0) { <p>No hay pads publicados por este shaper.</p> }
                    </div>
                </div>
            </div>
        </section>

