@model WebApplication2.Models.Configuracion.ConfiguracionViewModel
@using ClassLibrary.Enums
@{
    Layout = null;
    ViewData["Title"] = "Configuración";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Configuración — Zephyr Surf Go</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/configuracion.css" asp-append-version="true" />
</head>
<body>
    <partial name="_Navbar" />

    <main class="settings-page">
        <header class="settings-header">
            <p class="settings-eyebrow">Tu cuenta</p>
            <h1>Configuración</h1>
            <p>Actualizá tu información personal y protegé el acceso a tu cuenta.</p>
        </header>

        <div class="settings-grid">
            <section class="settings-card">
                <div class="settings-card-heading">
                    <span>01</span>
                    <div><h2>Información personal</h2><p>Datos comunes de tu cuenta en Zephyr Surf Go.</p></div>
                </div>

                @if (TempData["MensajeCuenta"] != null)
                {
                    <div class="settings-alert success">@TempData["MensajeCuenta"]</div>
                }
                @if (ViewData["ErrorCuenta"] != null)
                {
                    <div class="settings-alert error">@ViewData["ErrorCuenta"]</div>
                }

                <form asp-controller="Configuracion" asp-action="ActualizarCuenta" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="settings-alert error"></div>

                    <div class="settings-field">
                        <label asp-for="Cuenta.Nombre">Nombre</label>
                        <input asp-for="Cuenta.Nombre" autocomplete="name" />
                        <span asp-validation-for="Cuenta.Nombre"></span>
                    </div>
                    <div class="settings-field">
                        <label asp-for="Cuenta.Email">Correo electrónico</label>
                        <input asp-for="Cuenta.Email" autocomplete="email" />
                        <span asp-validation-for="Cuenta.Email"></span>
                    </div>
                    <div class="settings-field">
                        <label asp-for="Cuenta.Pais">País</label>
                        <select asp-for="Cuenta.Pais" asp-items="Html.GetEnumSelectList<Pais>()"></select>
                        <span asp-validation-for="Cuenta.Pais"></span>
                    </div>
                    <button type="submit" class="settings-button">Guardar información</button>
                </form>
            </section>

            <section class="settings-card">
                <div class="settings-card-heading">
                    <span>02</span>
                    <div><h2>Seguridad</h2><p>Cambiá tu contraseña confirmando primero la actual.</p></div>
                </div>

                @if (TempData["MensajeSeguridad"] != null)
                {
                    <div class="settings-alert success">@TempData["MensajeSeguridad"]</div>
                }
                @if (ViewData["ErrorSeguridad"] != null)
                {
                    <div class="settings-alert error">@ViewData["ErrorSeguridad"]</div>
                }

                <form asp-controller="Configuracion" asp-action="CambiarContrasenia" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="settings-alert error"></div>

                    <div class="settings-field">
                        <label asp-for="Seguridad.ContraseniaActual">Contraseña actual</label>
                        <input asp-for="Seguridad.ContraseniaActual" autocomplete="current-password" />
                        <span asp-validation-for="Seguridad.ContraseniaActual"></span>
                    </div>
                    <div class="settings-field">
                        <label asp-for="Seguridad.NuevaContrasenia">Nueva contraseña</label>
                        <input asp-for="Seguridad.NuevaContrasenia" autocomplete="new-password" />
                        <span asp-validation-for="Seguridad.NuevaContrasenia"></span>
                        <small>Usá al menos 8 caracteres.</small>
                    </div>
                    <div class="settings-field">
                        <label asp-for="Seguridad.ConfirmarContrasenia">Confirmar contraseña</label>
                        <input asp-for="Seguridad.ConfirmarContrasenia" autocomplete="new-password" />
                        <span asp-validation-for="Seguridad.ConfirmarContrasenia"></span>
                    </div>
                    <button type="submit" class="settings-button secondary">Cambiar contraseña</button>
                </form>
            </section>
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/navbar.js" asp-append-version="true"></script>
</body>
</html>
