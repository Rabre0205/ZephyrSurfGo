@model List<ClassLibrary.Interacciones.DisenoGuardado>
@{ Layout = null; }
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <title>Mis diseños guardados</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/navbar.css">
</head>
<body>
    <partial name="_Navbar" />
    <main class="container py-5" style="margin-top:70px;max-width:900px">
        <small class="text-primary text-uppercase fw-bold">Tus borradores</small>
        <h1>Mis diseños guardados</h1>
        <p class="text-secondary">Podés retomarlos y modificarlos. Guardar un diseño no crea una compra.</p>
        @if (Model.Count == 0)
        {
            <section class="border rounded-4 p-5 text-center">Todavía no guardaste diseños.</section>
        }
        else
        {
            @foreach (var diseno in Model)
            {
                <article class="border rounded-4 p-4 mb-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <div>
                        <h2 class="h5 mb-1">@diseno.Nombre</h2>
                        <small class="text-secondary">Guardado el @diseno.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-controller="Shaper" asp-action="Detalle" asp-route-id="@diseno.ShaperId" asp-route-disenoGuardado="@diseno.Id" asp-fragment="customizador" class="btn btn-primary">Continuar diseño</a>
                        <form asp-action="Eliminar" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@diseno.Id">
                            <button class="btn btn-outline-danger">Eliminar</button>
                        </form>
                    </div>
                </article>
            }
        }
    </main>
    <script src="~/js/navbar.js"></script>
</body>
</html>
