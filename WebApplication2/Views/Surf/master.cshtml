@{
    Layout = null;
    ViewData["Title"] = "Master";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Master Surfboards — The Shaper | Zephyr Surf Go</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/estilosMaster.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet" />

</head>
<body>

    <nav id="navbar">

        <a asp-controller="Surf" asp-action="Home" class="nav-logo">
            ZEPHYR <span>SURF</span> GO
        </a>

        <ul class="nav-links d-none d-md-flex">
            <li><a asp-controller="Surf" asp-action="Home">Home</a></li>
            <li><a asp-controller="Surf" asp-action="shapers">Shapers</a></li>      
            <li><a asp-controller="Surf" asp-action="Dealers">Dealers</a></li>
        </ul>

        <div class="nav-actions">

            <a asp-controller="Surf" asp-action="login" class="btn-login">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
                <span>Ingresar</span>
            </a>

            <a asp-controller="Surf" asp-action="carrito" class="btn-cart-nav">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="9" cy="21" r="1" />
                    <circle cx="20" cy="21" r="1" />
                    <path d="M1 1h4l2.68 13.39a2 2 0 001.99 1.61H19a2 2 0 001.99-1.79L22 7H6" />
                </svg>
                Carrito
                <span class="cart-badge">0</span>
            </a>

        </div>

    </nav>

    <!-- ── HERO ── -->
    <section id="hero">
        <div class="hero-bg-grad"></div>
        <div class="hero-lines">
            <div class="hero-line"></div>
            <div class="hero-line"></div>
            <div class="hero-line"></div>
        </div>
        <!-- Floating board shapes -->
        <svg class="hero-board" viewBox="0 0 80 300" xmlns="http://www.w3.org/2000/svg" fill="none">
            <path d="M40 4 C65 40, 72 100, 72 160 C72 220, 65 265, 40 296 C15 265, 8 220, 8 160 C8 100, 15 40, 40 4Z" fill="white" />
        </svg>
        <svg class="hero-board-2" viewBox="0 0 60 220" xmlns="http://www.w3.org/2000/svg" fill="none">
            <path d="M30 3 C48 28, 55 75, 55 120 C55 165, 48 198, 30 217 C12 198, 5 165, 5 120 C5 75, 12 28, 30 3Z" fill="white" />
        </svg>

        <div class="hero-overlay"></div>
        <div class="hero-content">
            <div class="breadcrumb-nav">
                <a href="index2.html">Dealers</a>
                <span class="sep">›</span>
                <a href="#">Uruguay</a>
                <span class="sep">›</span>
                <span class="current">Master Surfboards</span>
            </div>
            <span class="hero-badge">🇺🇾 Marca uruguaya</span>
            <p class="hero-eyebrow">The Shaper</p>
            <h1 class="hero-title">
                MASTER<br>
                <em class="thin">Surfboards</em>
            </h1>
            <p class="hero-sub">Hechas a mano en Uruguay desde 1998. Cada tabla es una conversación entre el shaper, el océano y vos.</p>
            <div class="hero-cta-row">
                <a href="#recomendador" class="btn-gold">Encontrá tu tabla ideal</a>
                <a href="#tablas" class="btn-ghost-white">Ver catálogo</a>
            </div>
            <div class="hero-stats">
                <div class="hstat"><div class="hstat-num">26</div><div class="hstat-label">Años de oficio</div></div>
                <div class="hstat"><div class="hstat-num">400+</div><div class="hstat-label">Tablas entregadas</div></div>
                <div class="hstat"><div class="hstat-num">100%</div><div class="hstat-label">Artesanal</div></div>
                <div class="hstat"><div class="hstat-num">UY</div><div class="hstat-label">Origen</div></div>
            </div>
        </div>
        <div class="scroll-hint">
            <div class="scroll-line"></div>
            <span>Scroll</span>
        </div>
    </section>

    <div class="section-divider"></div>

    <!-- ── TABLAS DESTACADAS ── -->
    <section id="tablas">
        <p class="section-eyebrow reveal">Catálogo selecto</p>
        <h2 class="section-title reveal">Tablas Master</h2>
        <p class="section-sub reveal">Los modelos más pedidos de la temporada. Cada una con su propia personalidad, pensada para un tipo de surfer y un tipo de ola.</p>

        <div class="boards-grid">

            <!-- Featured board -->
            <div class="board-card featured reveal" onclick="selectBoard('gaucho')">
                <div class="board-visual" style="background: linear-gradient(135deg, #0a1828, #0d2040);">
                    <div class="board-bg-circle"></div>
                    <div class="board-shape-wrap">
                        <img src="~/img/tabla.png"
                             alt="El Gaucho"
                             class="master-board-img">
                    </div>
                    <span class="board-badge">⭐ Best Seller</span>
                </div>
                <div class="board-info">
                    <p class="board-cat">Shortboard · Performance</p>
                    <p class="board-name">El Gaucho</p>
                    <p class="board-spec">6'2" × 18¾" × 2⅜" · 28.5L · Thruster</p>
                    <p class="board-desc">La tabla emblema de Master. Diseñada para olas de 2 a 6 pies con power, el Gaucho combina un rocker medio con raíles medios-bajos que permiten surfear suelto y agresivo. El modelo favorito de los surfistas locales avanzados.</p>
                    <div class="board-footer">
                        <span class="board-price">USD 780</span>
                        <button class="btn-add-small" onclick="event.stopPropagation(); addToCart('gaucho', 'El Gaucho', 780)">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                            Agregar
                        </button>
                    </div>
                </div>
            </div>

            <!-- Board 2 -->
            <div class="board-card reveal" onclick="selectBoard('pampeano')">
                <div class="board-visual" style="background: linear-gradient(135deg, #0a1a28, #0d2235);">
                    <div class="board-bg-circle"></div>
                    <div class="board-shape-wrap">
                        <img src="~/img/tabla.png"
                             alt="El Gaucho"
                             class="master-board-img">
                    </div>
                    <span class="board-badge new">Nuevo</span>
                </div>
                <div class="board-info">
                    <p class="board-cat">Mid-Length · Versátil</p>
                    <p class="board-name">El Pampeano</p>
                    <p class="board-spec">7'0" × 20½" × 2¾" · 42L · 2+1</p>
                    <p class="board-desc">La transición perfecta. Para el que viene del longboard y quiere más movilidad, o el shortboarder que quiere disfrutar olas más chicas sin resignar estilo.</p>
                    <div class="board-footer">
                        <span class="board-price">USD 660</span>
                        <button class="btn-add-small" onclick="event.stopPropagation(); addToCart('pampeano', 'El Pampeano', 660)">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                            Agregar
                        </button>
                    </div>
                </div>
            </div>

            <!-- Board 3 -->
            <div class="board-card reveal" onclick="selectBoard('charrua')">
                <div class="board-visual" style="background: linear-gradient(135deg, #0e1a10, #152218);">
                    <div class="board-bg-circle" style="background: radial-gradient(circle, rgba(46,194,126,.06) 0%, transparent 70%);"></div>
                   <div class="board-shape-wrap">
                        <img src="~/img/tabla.png"
                         alt="El Gaucho"
                          class="master-board-img">
                        </div>
                    </div>
                </div>
                <div class="board-info">
                    <p class="board-cat">Longboard · Clásico</p>
                    <p class="board-name">El Charrúa</p>
                    <p class="board-spec">9'2" × 22½" × 3" · 75L · Single-fin</p>
                    <p class="board-desc">Noseriding clásico. Madera de cedro en el stringer, canales laterales únicos y el rocker que convirtió a Master en referente del longboard rioplatense.</p>
                    <div class="board-footer">
                        <span class="board-price">USD 950</span>
                        <button class="btn-add-small" onclick="event.stopPropagation(); addToCart('charrua', 'El Charrúa', 950)">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                            Agregar
                        </button>
                    </div>
                </div>
            </div>

            <!-- Board 4 -->
            <div class="board-card reveal" onclick="selectBoard('playero')">
                <div class="board-visual" style="background: linear-gradient(135deg, #1a1018, #241528);">
                    <div class="board-bg-circle" style="background: radial-gradient(circle, rgba(180,100,220,.06) 0%, transparent 70%);"></div>
                    <div class="board-shape-wrap">
                        <div class="board-shape-wrap">
    <img src="~/img/tabla.png"
         alt="El Gaucho"
         class="master-board-img">

                    </div>
                </div>
                <div class="board-info">
                    <p class="board-cat">Fish · Retro</p>
                    <p class="board-name">El Playero</p>
                    <p class="board-spec">5'10" × 20¾" × 2½" · 35L · Twin-fin</p>
                    <p class="board-desc">Para las olas chatas y sin fuerza del Río de la Plata. El fish twin-fin con el que Master se divertía antes de que existiera la Punta. Suelta, veloz y adictiva.</p>
                    <div class="board-footer">
                        <span class="board-price">USD 590</span>
                        <button class="btn-add-small" onclick="event.stopPropagation(); addToCart('playero', 'El Playero', 590)">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                            Agregar
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <div class="section-divider"></div>

    <!-- ── RECOMENDADOR ── -->
    <section id="recomendador">
        <div class="rec-intro reveal">
            <p class="section-eyebrow">Personalizá tu experiencia</p>
            <h2 class="section-title">Creá tu tabla ideal</h2>
            <p class="section-sub">Respondé unas preguntas y el sistema de Master te recomienda la tabla perfecta para tu nivel, físico y tipo de ola.</p>
        </div>

        <!-- Progress dots -->
        <div class="rec-progress" id="recProgress">
            <div class="rec-step-dot active" data-step="0">1</div>
            <div class="rec-step-line"></div>
            <div class="rec-step-dot" data-step="1">2</div>
            <div class="rec-step-line"></div>
            <div class="rec-step-dot" data-step="2">3</div>
            <div class="rec-step-line"></div>
            <div class="rec-step-dot" data-step="3">4</div>
            <div class="rec-step-line"></div>
            <div class="rec-step-dot" data-step="4">5</div>
            <div class="rec-step-line"></div>
            <div class="rec-step-dot" data-step="5">6</div>
        </div>

        <div class="rec-panel">
            <!-- Question form -->
            <div id="rec-form">
                <div class="rec-question-card" id="recCard"></div>
            </div>

            <!-- Result -->
            <div id="rec-result">
                <div class="result-header reveal">
                    <div class="rec-tag">✓ Análisis completado</div>
                    <h3 id="resultTitle">Tu tabla ideal es...</h3>
                    <p id="resultSub">Basado en tus respuestas, Master recomienda:</p>
                </div>
                <div class="result-card">
                    <div class="result-visual">
                        <div id="resultBoardSvg"></div>
                    </div>
                    <div class="result-body">
                        <span class="result-match">98% de compatibilidad</span>
                        <p class="result-board-cat" id="resultCat"></p>
                        <p class="result-board-name" id="resultName"></p>
                        <p class="result-board-spec" id="resultSpec"></p>
                        <div class="result-board-why" id="resultWhy"></div>
                        <div class="result-specs" id="resultSpecStats"></div>
                        <p class="result-price" id="resultPrice"></p>
                        <div class="result-actions">
                            <button class="btn-gold" onclick="addResultToCart()">Agregar al carrito</button>
                            <a href="#customizador" class="btn-ghost-white" onclick="applyRecommendedBoard()">Customizar esta tabla</a>
                        </div>
                    </div>
                </div>
                <div class="result-actions-row">
                    <button class="btn-ghost-white" onclick="restartRec()">↩ Hacer de nuevo</button>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
     CUSTOM ORDER
════════════════════════════════════════════════════════ -->
    <section id="customizador">

        <div class="custom-intro reveal">
            <p class="section-eyebrow">Custom Order</p>
            <h2 class="section-title">Customizá tu tabla</h2>

            <p class="section-sub">
                Seleccioná el modelo, las medidas, la construcción,
                las quillas y los detalles de tu nueva tabla Master.
            </p>
        </div>

        <!-- TABLA + CARACTERÍSTICAS -->
        <div class="custom-order-main">

            <!-- ─────────────────────────────
             COLUMNA IZQUIERDA: TABLA
        ────────────────────────────── -->
            <aside class="custom-board-column">

                <div class="board-view-tabs">
                    <button type="button"
                            class="board-view-tab active"
                            data-board-view="deck"
                            onclick="changeBoardView('deck', this)">
                        Deck
                    </button>

                    <button type="button"
                            class="board-view-tab"
                            data-board-view="bottom"
                            onclick="changeBoardView('bottom', this)">
                        Bottom
                    </button>
                </div>

                <!-- DECK -->
                <div class="real-board-stage active"
                     id="deckStage">

                    <div id="deckPaint"
                         class="board-paint-layer deck-paint-layer">
                    </div>

                    <img id="deckBase"
                         class="board-image-layer board-base-layer"
                         src="~/img/boards/deck-mask.png"
                         alt="Vista superior de la tabla">

                    <img id="deckCarbon"
                         class="board-accessory board-carbon"
                         src="~/img/boards/carbon-patch.png"
                         alt="Parche de carbono"
                         hidden>

                    <img id="deckGrip"
                         class="board-accessory board-grip"
                         src="~/img/boards/grip-black.png"
                         alt="Grip"
                         hidden>

                    <div id="deckLogo"
                         class="board-master-logo">
                        MASTER
                    </div>

                    <div id="deckStringerName"
                         class="board-stringer-name">
                    </div>

                </div>

                <!-- BOTTOM -->
                <div class="real-board-stage"
                     id="bottomStage"
                     hidden>

                    <div id="bottomPaint"
                         class="board-paint-layer bottom-paint-layer">
                    </div>

                    <img id="bottomBase"
                         class="board-image-layer board-base-layer"
                         src="~/img/boards/bottom-base.png"
                         alt="Vista inferior de la tabla">

                    <img id="bottomCarbon"
                         class="board-accessory board-carbon bottom-carbon"
                         src="~/img/boards/carbon-patch.png"
                         alt="Parche de carbono"
                         hidden>

                    <img id="bottomFins"
                         class="board-accessory board-fin-preview"
                         src="~/img/boards/thruster.png"
                         alt="Configuración de quillas">

                </div>

                <div class="board-current-specs">

                    <div class="board-current-spec">
                        <span>Modelo</span>
                        <strong id="sidePreviewModel">El Gaucho</strong>
                    </div>

                    <div class="board-current-spec">
                        <span>Construcción</span>
                        <strong id="sidePreviewConstruction">PU Stringer</strong>
                    </div>

                    <div class="board-current-spec">
                        <span>Medidas</span>
                        <strong id="sidePreviewSize">
                            5'7" × 18 7/16" × 2 1/8"
                        </strong>
                    </div>

                    <div class="board-current-spec">
                        <span>Volumen</span>
                        <strong id="sidePreviewVolume">22.5L</strong>
                    </div>

                    <div class="board-current-spec">
                        <span>Tail</span>
                        <strong id="sidePreviewTail">Squash</strong>
                    </div>

                    <div class="board-current-spec">
                        <span>Quillas</span>
                        <strong id="sidePreviewFins">FCS · Thruster</strong>
                    </div>

                    <div class="board-current-spec">
                        <span>Glassing</span>
                        <strong id="sidePreviewGlassing">
                            PU Regular Innegra
                        </strong>
                    </div>

                    <div class="board-current-spec">
                        <span>Carbon patch</span>
                        <strong id="sidePreviewCarbon">
                            Progressive Carbon White
                        </strong>
                    </div>

                    <div class="board-current-spec">
                        <span>Diseño</span>
                        <strong id="sidePreviewDesign">Sol Pampeano</strong>
                    </div>

                    <div class="board-current-spec board-current-price">
                        <span>Precio estimado</span>
                        <strong id="sidePreviewPrice">USD 930</strong>
                    </div>

                </div>

                <button type="button"
                        class="board-download-button"
                        onclick="downloadBoardPreview()">
                    ↓
                </button>

            </aside>

            <!-- ─────────────────────────────
             COLUMNA DERECHA: DETALLES
        ────────────────────────────── -->
            <div class="custom-details-column">

                <h3 class="custom-details-title">
                    Board Details
                </h3>

                <!-- Modelo -->
                <div class="custom-field">
                    <label for="customModel">
                        Surfboard model
                    </label>

                    <select class="custom-select"
                            id="customModel">

                        <optgroup label="Master Surfboards">
                            <option value="gaucho" selected>
                                El Gaucho
                            </option>

                            <option value="pampeano">
                                El Pampeano
                            </option>

                            <option value="charrua">
                                El Charrúa
                            </option>

                            <option value="playero">
                                El Playero
                            </option>
                        </optgroup>

                        <optgroup label="Grom / Youth">
                            <option value="grom-plus">Grom +</option>
                            <option value="grom-two">Grom Two</option>
                            <option value="mini-bird">Mini Bird</option>
                            <option value="spawn-mini">Spawn Mini</option>
                        </optgroup>

                        <optgroup label="Groveller">
                            <option value="bv2">BV2</option>
                            <option value="fire-chief">Fire Chief</option>
                            <option value="hkii">HKII</option>
                            <option value="miami-spice">Miami Spice</option>
                            <option value="pina-colada">Piña Colada</option>
                            <option value="popper">Popper</option>
                            <option value="pretty-sweet">Pretty Sweet</option>
                        </optgroup>

                        <optgroup label="All Rounder">
                            <option value="black-vulture">Black Vulture</option>
                            <option value="churro">Churro</option>
                            <option value="churro-2">Churro 2</option>
                            <option value="hot-knife">Hot Knife</option>
                            <option value="middy">Middy</option>
                            <option value="rare-bird">Rare Bird</option>
                            <option value="rare-bird-evo">Rare Bird EVO</option>
                            <option value="rarest-bird">Rarest Bird</option>
                            <option value="volume-2">Volume II</option>
                        </optgroup>

                        <optgroup label="Premium Performance">
                            <option value="shortie">Shortie</option>
                            <option value="a2">A2</option>
                            <option value="fad3r">FAD3R</option>
                            <option value="faded">Faded</option>
                            <option value="faded-2">Faded 2.0</option>
                        </optgroup>

                        <optgroup label="Step Up / Gun">
                            <option value="faded-gun">
                                Faded 2.0 Gun
                            </option>

                            <option value="faded-step-up">
                                Faded 2.0 Step Up
                            </option>
                        </optgroup>

                        <optgroup label="Twin">
                            <option value="peppa-twin">Peppa Twin</option>
                            <option value="sugar">Sugar</option>
                        </optgroup>

                        <optgroup label="Mid Length">
                            <option value="full-strength">Full Strength</option>
                            <option value="mid-strength">Mid Strength</option>
                            <option value="twin-strength">Twin Strength</option>
                        </optgroup>

                    </select>
                </div>

                <!-- Construcción -->
                <div class="custom-field">
                    <label for="customConstruction">
                        Technology / Construction
                    </label>

                    <select class="custom-select"
                            id="customConstruction">

                        <option value="pu-stringer" selected>
                            PU Stringer
                        </option>

                        <option value="eps-stringer">
                            EPS Stringer
                        </option>

                        <option value="eps-future-flex">
                            EPS Future Flex
                        </option>

                        <option value="eps-core-reactor">
                            EPS X Core Reactor
                        </option>

                        <option value="eps-twin-tech">
                            EPS Twin Tech
                        </option>

                    </select>
                </div>

                <!-- Medidas recomendadas -->
                <div class="custom-field">
                    <label for="customStockMeasurements">
                        Recommended stock measurements
                    </label>

                    <select class="custom-select"
                            id="customStockMeasurements">

                        <option value="5'7|18 7/16|2 1/8|22.5"
                                selected>
                            5'7" × 18 7/16" × 2 1/8" × 22.5L
                        </option>

                        <option value="5'8|18 5/8|2 1/4|24.4">
                            5'8" × 18 5/8" × 2 1/4" × 24.4L
                        </option>

                        <option value="5'9|18 7/8|2 1/4|25.2">
                            5'9" × 18 7/8" × 2 1/4" × 25.2L
                        </option>

                        <option value="5'10|19|2 5/16|26.6">
                            5'10" × 19" × 2 5/16" × 26.6L
                        </option>

                        <option value="6'0|19 1/4|2 3/8|28.9">
                            6'0" × 19 1/4" × 2 3/8" × 28.9L
                        </option>

                        <option value="6'2|19 1/2|2 1/2|31.5">
                            6'2" × 19 1/2" × 2 1/2" × 31.5L
                        </option>

                    </select>
                </div>

                <!-- Size -->
                <div class="custom-measurement-box">

                    <div class="custom-measurement-field">
                        <label for="customLength">
                            Size
                        </label>

                        <select class="custom-select"
                                id="customLength">

                            <option>5'6"</option>
                            <option selected>5'7"</option>
                            <option>5'8"</option>
                            <option>5'9"</option>
                            <option>5'10"</option>
                            <option>5'11"</option>
                            <option>6'0"</option>
                            <option>6'1"</option>
                            <option>6'2"</option>
                            <option>6'3"</option>
                            <option>6'4"</option>
                            <option>6'6"</option>
                            <option>7'0"</option>
                            <option>8'0"</option>
                            <option>9'0"</option>

                        </select>
                    </div>

                    <div class="custom-measurement-field">
                        <label for="customWidth">
