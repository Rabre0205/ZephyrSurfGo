@{
    Layout = null;
    ViewData["Title"] = "Dealer";
}


<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dealers — Zephyr Surf Go</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap"
          rel="stylesheet" />
    <!-- Leaflet map -->
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <link rel="stylesheet" href="~/css/estilosDealers.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />

</head>
<body>

    <!-- NAVBAR -->
    <partial name="_Navbar" />

   
    <!-- ── HERO ── -->
    <section id="hero">
        <div class="hero-bg"
             style="
        background-image: url('../img/Dealers.jpeg');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        height: 100vh;
        "></div>
        <div class="hero-overlay"></div>
        <div class="scroll-hint">
            <div class="scroll-line"></div>
        </div>
    </section>

    <!-- ══════════════════════════════════
       PAGE HEADER
  ══════════════════════════════════ -->
    <div class="page-header">
        <div class="breadcrumb">
            <a href="zephyr-surf-go.html">Inicio</a>
            <span>›</span>
            <span>Dealers</span>
        </div>
        <h1>Shop Locator</h1>
        <p>
            Encontrá el dealer más cercano a tu ola en Argentina, Brasil y Uruguay.
        </p>
    </div>

    <!-- ══════════════════════════════════
       FILTER BAR
  ══════════════════════════════════ -->
    <div class="filter-bar">
        <span class="filter-label">Filtrar por:</span>
        <button class="filter-btn active" data-filter="all">Todos</button>
        <button class="filter-btn" data-filter="ar">🇦🇷 Argentina</button>
        <button class="filter-btn" data-filter="br">🇧🇷 Brasil</button>
        <button class="filter-btn" data-filter="uy">🇺🇾 Uruguay</button>
        <div class="search-wrap">
            <svg xmlns="http://www.w3.org/2000/svg"
                 width="14"
                 height="14"
                 fill="currentColor"
                 viewBox="0 0 16 16">
                <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.099zm-5.242 1.656a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11z" />
            </svg>
            <input type="text"
                   id="searchInput"
                   placeholder="Buscar ciudad o tienda…" />
        </div>
    </div>

    <!-- ══════════════════════════════════
       MAIN: LISTA + MAPA
  ══════════════════════════════════ -->
    <div class="dealers-layout">
        <!-- Lista -->
        <div class="dealers-list" id="dealersList">
            <!-- generado por JS -->
        </div>

        <!-- Mapa Leaflet -->
        <div id="map"></div>
    </div>

    <!-- ══════════════════════════════════
       BECOME A DEALER
  ══════════════════════════════════ -->
    <div class="become-dealer">
        <div>
            <h2>¿Querés ser dealer<br />de Zephyr Surf Go?</h2>
            <p>
                Sumá las mejores tablas artesanales de Latinoamérica a tu surf shop.
                Escribinos y te contamos cómo unirte a la red.
            </p>
        </div>
        <a href="zephyr-surf-go.html#contacto" class="btn-dealer-cta">Contactanos</a>
    </div>

    <!-- ══════════════════════════════════
       FOOTER
  ══════════════════════════════════ -->
    <footer>
        <div class="footer-inner">
            <div>
                <div class="footer-logo">ZEPHYR <span>SURF</span> GO</div>
                <div class="footer-tagline">
                    Tablas de autor. Olas latinoamericanas.
                </div>
            </div>
            <ul class="footer-links">
                <li><a href="zephyr-surf-go.html">Inicio</a></li>
                <li><a href="zephyr-surf-go.html#tablas">Tablas</a></li>
                <li><a href="#">Dealers</a></li>
                <li><a href="zephyr-surf-go.html#about">Nosotros</a></li>
                <li><a href="zephyr-surf-go.html#contacto">Contacto</a></li>
            </ul>
            <div class="footer-countries">
                <h6>Regiones</h6>
                <ul>
                    <li>🇦🇷 Argentina</li>
                    <li>🇧🇷 Brasil</li>
                    <li>🇺🇾 Uruguay</li>
                </ul>
            </div>
        </div>
        <p class="footer-copy">
            © 2025 Zephyr Surf Go — Todos los derechos reservados.
        </p>
    </footer>



    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/Dealers.js" asp-append-version="true"></script>
    <script src="~/js/navbar.js" asp-append-version="true"></script>
</body>
</html>
