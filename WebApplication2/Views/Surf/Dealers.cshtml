@model WebApplication2.Models.ShapersCatalogoViewModel
@using ClassLibrary.Enums
@using System.Text.Json
@{ Layout = null; ViewData["Title"] = "Mapa de shapers"; }
<!doctype html>
<html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Mapa de shapers — Zephyr Surf Go</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<link rel="stylesheet" href="~/css/estilosDealers.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true"/>
</head><body><partial name="_Navbar"/>
<section class="map-hero"><div><span>Red Zephyr Surf Go</span><h1>Encontrá tu shaper</h1><p>Explorá talleres activos de Uruguay, Argentina y Brasil y conocé sus tablas disponibles.</p></div></section>
<main class="locator-page"><div class="locator-note"><strong>Ubicación por país</strong><span>La dirección exacta del taller todavía no forma parte del perfil. El mapa muestra el país de cada shaper, sin inventar domicilios.</span></div>
<div class="filter-bar"><span class="filter-label">Filtrar:</span><button class="filter-btn active" data-filter="all">Todos</button><button class="filter-btn" data-filter="ar">🇦🇷 Argentina</button><button class="filter-btn" data-filter="br">🇧🇷 Brasil</button><button class="filter-btn" data-filter="uy">🇺🇾 Uruguay</button><div class="search-wrap"><span>⌕</span><input type="search" id="searchInput" placeholder="Buscar shaper o país…"/></div></div>
<div class="results-summary"><span id="resultCount">@Model.Shapers.Count shapers</span><small>Seleccioná uno para conocer sus productos.</small></div>
<div class="dealers-layout"><div class="dealers-list" id="dealersList"></div><div class="map-panel"><div id="map"></div><p>Los marcadores representan cobertura por país, no la dirección exacta.</p></div></div>
</main>
<script>
window.zephyrShapers = @Html.Raw(JsonSerializer.Serialize(Model.Shapers.Select(item => new {
    id = item.Shaper.Id,
    name = string.IsNullOrWhiteSpace(item.Shaper.NombreDeNegosio) ? item.Shaper.Nombre : item.Shaper.NombreDeNegosio,
    owner = item.Shaper.Nombre,
    country = item.Shaper.Pais == Pais.Argentina ? "ar" : item.Shaper.Pais == Pais.Brasil ? "br" : "uy",
    countryName = item.Shaper.Pais.ToString(),
    products = item.CantidadProductos,
    contact = item.Shaper.Contacto,
    logo = item.Shaper.LogoUrl,
    pageUrl = Url.Action("Detalle", "Shaper", new { id = item.Shaper.Id })
})));
</script>
<script src="~/js/Dealers.js" asp-append-version="true"></script><script src="~/js/navbar.js" asp-append-version="true"></script></body></html>
