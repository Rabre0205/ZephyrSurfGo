                        <span class="style-tag">Big Wave</span>
                        <span class="style-tag">Shortboard</span>
                    </div>
                    <div class="shaper-cta">
                        <a href="#" class="cta-link" onclick="event.stopPropagation(); openModal('ferreira')">Ver perfil <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7" /></svg></a>
                        <span class="cta-boards">2 tablas</span>
                    </div>
                </div>
            </div>

            <!-- CARD 5 -->
            <div class="shaper-card reveal" data-country="UY" data-styles="shortboard fish" data-name="valentina suárez" onclick="openModal('suarez')">
                <div class="shaper-portrait">
                    <svg viewBox="0 0 300 400" xmlns="http://www.w3.org/2000/svg">
                        <rect width="300" height="400" fill="#1a2030" />
                        <ellipse cx="150" cy="155" rx="62" ry="68" fill="#283050" />
                        <rect x="88" y="210" width="124" height="190" rx="10" fill="#283050" />
                        <ellipse cx="30" cy="160" rx="14" ry="65" fill="rgba(67,148,224,.09)" transform="rotate(-8 30 160)" />
