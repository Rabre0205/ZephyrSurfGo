                        <a href="#" class="cta-link" onclick="event.stopPropagation(); openModal('suarez')">Ver perfil <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7" /></svg></a>
