@{
    Layout = null;
    ViewData["Title"] = "Shapers";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shapers — Zephyr Surf Go</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="../CSS/estilosShapers.css">
</head>
<body>

    <!-- ── NAVBAR ── -->
    <nav id="navbar">
        <a href="index.html" class="nav-logo">ZEPHYR <span>SURF</span> GO</a>
        <ul class="nav-links d-none d-md-flex">
            <li><a href="index.html">Home</a></li>
            <li><a href="index.html#tablas">Tablas</a></li>
            <li><a href="shapers.html" class="active">Shapers</a></li>
            <li><a href="#about">Nosotros</a></li>
            <li><a href="Dealers.html">Dealers</a></li>
        </ul>
        <div class="nav-actions">
            <a href="login.html" class="btn-login">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
                <span>Ingresar</span>
            </a>
            <a href="carrito.html" class="btn-cart-nav">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="9" cy="21" r="1" />
                    <circle cx="20" cy="21" r="1" />
                    <path d="M1 1h4l2.68 13.39a2 2 0 001.99 1.61H19a2 2 0 001.99-1.79L22 7H6" />
                </svg>
