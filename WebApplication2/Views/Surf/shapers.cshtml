                <span class="cart-badge" id="cartBadge">0</span>
            </a>
        </div>
    </nav>

    <!-- ── HERO ── -->
    <section id="hero">
        <div class="hero-bg"></div>
        <div class="hero-waves">
            <div class="wave-line"></div>
            <div class="wave-line"></div>
            <div class="wave-line"></div>
            <div class="wave-line"></div>
            <div class="wave-line"></div>
        </div>
        <div class="hero-bg-text">SHAPE</div>
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <span class="hero-eyebrow">Los artesanos detrás de cada ola</span>
            <h1 class="hero-title">CONOCÉ A LOS <em>SHAPERS</em></h1>
            <p class="hero-sub">Cada tabla tiene una historia. Detrás de cada curva hay años de experiencia, pasión y olas surfidas. Estos son los maestros.</p>
            <div class="hero-stats">
                <div>
                    <div class="hstat-num">20+</div>
                    <div class="hstat-label">Shapers activos</div>
                </div>
                <div>
                    <div class="hstat-num">3</div>
                    <div class="hstat-label">Países</div>
                </div>
                <div>
                    <div class="hstat-num">15+</div>
                    <div class="hstat-label">Años promedio</div>
                </div>
                <div>
                    <div class="hstat-num">100%</div>
                    <div class="hstat-label">Artesanal</div>
                </div>
            </div>
        </div>
        <div class="scroll-hint">
            <div class="scroll-line"></div>
            <span>Scroll</span>
        </div>
    </section>

    <!-- ── FILTER BAR ── -->
    <div class="filter-bar">
        <span class="filter-label">Filtrar por</span>
        <div class="filter-chips">
            <button class="chip active" data-filter="all">Todos</button>
            <button class="chip" data-filter="AR">🇦🇷 Argentina</button>
            <button class="chip" data-filter="BR">🇧🇷 Brasil</button>
            <button class="chip" data-filter="UY">🇺🇾 Uruguay</button>
            <button class="chip" data-filter="shortboard">Shortboard</button>
            <button class="chip" data-filter="longboard">Longboard</button>
            <button class="chip" data-filter="gun">Gun / Big Wave</button>
        </div>
        <div class="filter-search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input type="text" id="searchInput" placeholder="Buscar shaper…" />
        </div>
    </div>

    <!-- ── SHAPERS GRID ── -->
    <section id="shapers">
        <p class="section-label reveal">Nuestros artesanos</p>
        <h2 class="section-title reveal">Los shapers de la región</h2>
        <p class="section-sub reveal">Maestros del foam y la fibra que dan vida a las mejores olas de Argentina, Brasil y Uruguay.</p>

        <div class="shapers-grid" id="shapersGrid">

            <!-- FEATURED -->
            <div class="featured-shaper reveal" data-country="UY" data-styles="longboard shortboard" data-name="diego rocca" onclick="openModal('rocca')">
                <div class="featured-portrait">
                    <svg viewBox="0 0 340 360" xmlns="http://www.w3.org/2000/svg">
                        <rect width="340" height="360" fill="#063f4a" />
                        <ellipse cx="170" cy="140" rx="70" ry="78" fill="#0a5566" />
                        <rect x="100" y="205" width="140" height="155" rx="12" fill="#0a5566" />
                        <!-- board shape in bg -->
                        <ellipse cx="290" cy="200" rx="30" ry="110" fill="rgba(67,148,224,.08)" transform="rotate(-15 290 200)" />
                        <ellipse cx="60" cy="100" rx="20" ry="70" fill="rgba(67,148,224,.05)" transform="rotate(20 60 100)" />
                        <!-- wave texture lines -->
                        <path d="M0 300 Q85 280 170 300 Q255 320 340 300" stroke="rgba(255,255,255,.06)" stroke-width="1.5" fill="none" />
                        <path d="M0 320 Q85 300 170 320 Q255 340 340 320" stroke="rgba(255,255,255,.04)" stroke-width="1" fill="none" />
                    </svg>
                    <span class="featured-badge">⭐ Shaper destacado</span>
                </div>
                <div class="featured-body">
                    <p class="shaper-origin">🇺🇾 Punta del Este, Uruguay</p>
                    <p class="shaper-name">Diego Rocca</p>
                    <p class="shaper-years">28 años de experiencia</p>
                    <p class="shaper-bio">El referente del surf uruguayo. Diego comenzó a shapear en 1996 y hoy es el nombre más respetado de la región rioplatense. Sus longboards son reconocidos por su equilibrio perfecto entre performance y fluidez.</p>
                    <div class="shaper-stats">
                        <div class="sstat"><div class="sstat-num">340+</div><div class="sstat-label">Tablas</div></div>
                        <div class="sstat"><div class="sstat-num">28</div><div class="sstat-label">Años</div></div>
                        <div class="sstat"><div class="sstat-num">4</div><div class="sstat-label">Modelos</div></div>
                    </div>
                    <div class="shaper-styles">
                        <span class="style-tag">Longboard</span>
                        <span class="style-tag">Shortboard</span>
                        <span class="style-tag">Mid-length</span>
                        <span class="style-tag">Custom</span>
                    </div>
                    <div class="shaper-cta">
                        <a href="#" class="cta-link" onclick="event.stopPropagation(); openModal('rocca')">
                            Ver perfil completo
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
