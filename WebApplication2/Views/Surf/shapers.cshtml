                        <span class="cta-boards">4 tablas disponibles</span>
                    </div>
                </div>
            </div>

            <!-- CARD 1 -->
            <div class="shaper-card reveal" data-country="AR" data-styles="shortboard" data-name="marcos villalba" onclick="openModal('villalba')">
