                <div class="shaper-portrait">
                    <svg viewBox="0 0 300 400" xmlns="http://www.w3.org/2000/svg">
                        <rect width="300" height="400" fill="#1a2a3a" />
                        <ellipse cx="150" cy="155" rx="62" ry="68" fill="#253d55" />
                        <rect x="88" y="210" width="124" height="190" rx="10" fill="#253d55" />
                        <ellipse cx="150" cy="200" rx="15" ry="160" fill="rgba(67,148,224,.06)" transform="rotate(5 150 200)" />
                        <path d="M0 370 Q75 350 150 370 Q225 390 300 370" stroke="rgba(255,255,255,.07)" stroke-width="1.5" fill="none" />
                    </svg>
