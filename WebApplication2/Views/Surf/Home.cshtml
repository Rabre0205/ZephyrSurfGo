@{
    Layout = null;
    ViewData["Title"] = "Home";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Zephyr Surf Go</title>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/estilosHome.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
</head>
<body>

    <!-- NAVBAR -->
    <nav id="navbar">
        <a asp-controller="Surf" asp-action="Home" class="nav-logo">
            ZEPHYR <span>SURF</span> GO
        </a>

        <ul class="nav-links d-none d-md-flex">
            <li>
                <a asp-controller="Surf" asp-action="Home">Home</a>
            </li>

            <li>
                <a asp-controller="Surf" asp-action="Home" asp-fragment="tablas">Tablas</a>
            </li>

            <li>
                <a asp-controller="Surf" asp-action="shapers">Shapers</a>
            </li>

            <li>
                <a asp-controller="Surf" asp-action="Home" asp-fragment="about">Nosotros</a>
            </li>

            <li>
                <a asp-controller="Surf" asp-action="Dealers">Dealers</a>
            </li>

            <li>
                <a asp-controller="Surf" asp-action="Home" asp-fragment="tablasDestacadas">
                    Tablas destacadas
                </a>
            </li>
        </ul>

        <div class="nav-actions">

            <a asp-controller="Surf"
               asp-action="login"
               class="btn-login"
               id="navLoginBtn">

                <svg width="15" height="15" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>

                <span id="navLoginText">Ingresar</span>
            </a>

            <div class="util-dropdown">

                <button class="dropdown-toggle">
                    🌎 Marcas
                    <svg class="dropdown-arrow" width="12" height="12" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </button>

                <div class="marcas-menu">

                    <a href="#">
                        <img src="https://flagcdn.com/w20/ar.png" alt="">
                        AR
                    </a>

                    <a href="#">
                        <img src="https://flagcdn.com/w20/br.png" alt="">
                        BR
                    </a>

                    <div class="dropdown-submenu">

                        <a href="#">
                            <img src="https://flagcdn.com/w20/uy.png" alt="">
                            UY ▸
                        </a>

                        <div class="submenu">
                            <a asp-controller="Surf" asp-action="master">Master</a>
                        </div>

                    </div>

                </div>

            </div>

            <a asp-controller="Surf"
               asp-action="carrito"
               class="btn-cart-nav"
               id="btnCartNav">

                <svg width="15" height="15" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="9" cy="21" r="1" />
                    <circle cx="20" cy="21" r="1" />
                    <path d="M1 1h4l2.68 13.39a2 2 0 001.99 1.61H19a2 2 0 001.99-1.79L22 7H6" />
                </svg>

                <span>Carrito</span>
                <span class="cart-badge">0</span>

            </a>

        </div>
    </nav>

    <!-- HERO -->
    <section id="hero">
        <div class="hero-img"></div>
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <span class="hero-eyebrow">Uruguay · Argentina · Brasil</span>
            <h1 class="hero-title">
                Encontrá tu tabla.<br>
                <em>Personalizala.</em><br>
                Conectá con quien la fabrica.
            </h1>
            <p class="hero-sub">El marketplace de tablas artesanales de Latinoamérica.</p>
            <div class="hero-ctas">
                <a href="#como-funciona" class="cta-main">Encontrar mi tabla →</a>
                <a href="#shapers" class="cta-ghost">Ver shapers</a>
            </div>
        </div>
        <button class="hero-arrow hero-arrow-left">
            <svg viewBox="0 0 24 24">
                <path d="M15 4L7 12L15 20" />
            </svg>
        </button>

        <button class="hero-arrow hero-arrow-right">
            <svg viewBox="0 0 24 24">
                <path d="M9 4L17 12L9 20" />
            </svg>
        </button>

        <div class="scroll-hint">
            <div class="scroll-line"></div>
            <span>Deslizá para explorar</span>
        </div>
    </section>


    <!-- 3 CARDS GRANDES estilo Chilli -->
    <div class="big-cards">
        <div class="big-card">
            <img src="data:image/jpeg;base64," alt="Tablas artesanales" />
            <div class="big-card-overlay">
                <span class="big-card-tag">Shapers verificados</span>
                <div class="big-card-title">Fabricantes<br>artesanales</div>
                <a href="#" class="big-card-link">Conocer shapers →</a>
            </div>
        </div>
        <div class="big-card">
            <img src="data:image/jpeg;base64," alt="Personalizá tu diseño" />
            <div class="big-card-overlay">
                <span class="big-card-tag">Diseño único</span>
                <div class="big-card-title">Personalizá<br>cada detalle</div>
                <a href="#" class="big-card-link">Ver opciones →</a>
            </div>
        </div>
        <div class="big-card">
            <img src="data:image/jpeg;base64," alt="Surf en Latinoamérica" />
            <div class="big-card-overlay">
                <span class="big-card-tag">Tu tabla, tu perfil</span>
                <div class="big-card-title">Encontrá la<br>tabla perfecta</div>
                <a href="#" class="big-card-link">Empezar cuestionario →</a>
            </div>
        </div>
    </div>

    <!-- STRIP -->
    <div class="strip">
        <span class="strip-item">Shortboard</span><div class="strip-dot"></div>
        <span class="strip-item">Fish</span><div class="strip-dot"></div>
        <span class="strip-item">Longboard</span><div class="strip-dot"></div>
        <span class="strip-item">Groveller</span><div class="strip-dot"></div>
        <span class="strip-item">Big Wave</span><div class="strip-dot"></div>
        <span class="strip-item">Funboard</span><div class="strip-dot"></div>
        <span class="strip-item">Custom</span><div class="strip-dot"></div>
        <span class="strip-item">Tablas artesanales</span><div class="strip-dot"></div>
        <span class="strip-item">Shapers verificados</span><div class="strip-dot"></div>
        <span class="strip-item">Hecho a mano</span>
    </div>

    <!-- COMO FUNCIONA -->
    <section class="zp-section zp-section-pale" id="como-funciona">
        <div class="tc">
            <span class="zp-eyebrow">¿Cómo funciona?</span>
            <span class="zp-title">CUATRO PASOS, UNA TABLA</span>
        </div>
        <div class="steps">
            <div class="step">
                <div class="step-num">01</div>
                <div class="step-title">Respondé el cuestionario</div>
                <div class="step-desc">Nivel, olas, peso, altura y objetivos</div>
            </div>
            <div class="step">
                <div class="step-num">02</div>
                <div class="step-title">Recibí recomendaciones</div>
                <div class="step-desc">Tablas con % de compatibilidad para tu perfil</div>
            </div>
            <div class="step">
                <div class="step-num">03</div>
                <div class="step-title">Personalizá el diseño</div>
                <div class="step-desc">Colores, quillas, tail y accesorios</div>
            </div>
            <div class="step">
                <div class="step-num">04</div>
                <div class="step-title">El shaper la fabrica</div>
                <div class="step-desc">Seguí el estado en tiempo real</div>
            </div>
        </div>
        <div class="tc mt2">
            <a href="#" class="cta-main">Empezar ahora →</a>
        </div>
    </section>

    <!-- SHAPERS VERIFICADOS -->
    <section class="zp-section zp-section-dark" id="shapers">
        <div class="tc">
            <span class="zp-eyebrow">Shapers verificados</span>
            <span class="zp-title">LOS QUE FABRICAN TU TABLA</span>
        </div>
        <div class="zp-tabs">
            <button class="zp-tab active">Todos</button>
            <button class="zp-tab">🇺🇾 Uruguay</button>
            <button class="zp-tab">🇦🇷 Argentina</button>
            <button class="zp-tab">🇧🇷 Brasil</button>
        </div>
        <div class="shapers-grid">
            <div class="shaper-card">
                <div class="shaper-img">Foto shaper</div>
                <div class="shaper-body">
                    <div class="verified">✓ Verificado</div>
                    <div class="shaper-name">Rodrigo Fernández</div>
                    <div class="shaper-meta">Montevideo, UY · 12 modelos</div>
                    <div class="shaper-stars">★★★★★ (48)</div>
                </div>
            </div>
            <div class="shaper-card">
                <div class="shaper-img">Foto shaper</div>
                <div class="shaper-body">
                    <div class="verified">✓ Verificado</div>
                    <div class="shaper-name">Marcos Villalba</div>
                    <div class="shaper-meta">Buenos Aires, AR · 8 modelos</div>
                    <div class="shaper-stars">★★★★☆ (31)</div>
                </div>
            </div>
            <div class="shaper-card">
                <div class="shaper-img">Foto shaper</div>
                <div class="shaper-body">
                    <div class="verified">✓ Verificado</div>
                    <div class="shaper-name">Felipe Nunes</div>
                    <div class="shaper-meta">Florianópolis, BR · 15 modelos</div>
                    <div class="shaper-stars">★★★★★ (72)</div>
                </div>
            </div>
            <div class="shaper-card">
                <div class="shaper-img">Foto shaper</div>
                <div class="shaper-body">
                    <div class="verified">✓ Verificado</div>
                    <div class="shaper-name">Diego Rocca</div>
                    <div class="shaper-meta">Punta del Este, UY · 6 modelos</div>
                    <div class="shaper-stars">★★★★☆ (19)</div>
                </div>
            </div>
        </div>
        <div class="tc mt2">
            <a href="#" class="zp-btn-ghost">Ver todos los shapers →</a>
        </div>
    </section>

    <!-- TABLAS DESTACADAS -->
    <section class="zp-section" id="tablas">
        <span class="zp-eyebrow">Tablas destacadas</span>
        <span class="zp-title">LAS MÁS ELEGIDAS</span>
        <div class="zp-tabs">
            <button class="zp-tab active" style="border-color:#b8c8e0;color:#5a6e90;">Más populares</button>
            <button class="zp-tab" style="border-color:#b8c8e0;color:#5a6e90;">Mejor valoradas</button>
            <button class="zp-tab" style="border-color:#b8c8e0;color:#5a6e90;">Nuevas</button>
        </div>
        <div class="boards-grid">
            <div class="board-card">
                <div class="board-img">
                    <img src="~/img/tabla.png" alt="FAD3R">
                    <ellipse cx="30" cy="90" rx="22" ry="82" fill="none" stroke="#1a4fc4" stroke-width="1.5" />
                    <ellipse cx="30" cy="90" rx="13" ry="68" fill="none" stroke="#1a4fc4" stroke-width=".7" />
                    <line x1="30" y1="8" x2="30" y2="172" stroke="#1a4fc4" stroke-width=".6" />
            </div>
            <div class="board-body">
                <div class="board-name">Shortboard 6'2"</div>
                <div class="board-shaper">Fernández · Montevideo</div>
                <div class="board-compat">94% compatible</div>
                <div class="board-price">USD 650</div>
            </div>
        </div>
        <div class="board-card">
            <div class="board-img">
                    <img src="~/img/tabla.png" alt="FAD3R">
                <ellipse cx="40" cy="80" rx="32" ry="72" fill="none" stroke="#1a4fc4" stroke-width="1.5" />
                <ellipse cx="40" cy="80" rx="19" ry="58" fill="none" stroke="#1a4fc4" stroke-width=".7" />
                <line x1="40" y1="8" x2="40" y2="152" stroke="#1a4fc4" stroke-width=".6" />
        </div>
        <div class="board-body">
            <div class="board-name">Fish 5'8"</div>
            <div class="board-shaper">Villalba · Buenos Aires</div>
            <div class="board-compat">88% compatible</div>
            <div class="board-price">USD 580</div>
        </div>
    </div>
    <div class="board-card">
        <div class="board-img">
                    <img src="~/img/tabla.png" alt="FAD3R">
            <ellipse cx="25" cy="100" rx="18" ry="92" fill="none" stroke="#1a4fc4" stroke-width="1.5" />
            <ellipse cx="25" cy="100" rx="10" ry="76" fill="none" stroke="#1a4fc4" stroke-width=".7" />
            <line x1="25" y1="8" x2="25" y2="192" stroke="#1a4fc4" stroke-width=".6" />
    </div>
    <div class="board-body">
        <div class="board-name">Longboard 9'0"</div>
        <div class="board-shaper">Nunes · Florianópolis</div>
        <div class="board-compat">91% compatible</div>
        <div class="board-price">USD 820</div>
    </div>
</div>
<div class="board-card">
    <div class="board-img">
        <img src="../IMG/tabla.png" alt="FAD3R">
        <ellipse cx="37" cy="77" rx="30" ry="68" fill="none" stroke="#1a4fc4" stroke-width="1.5" />
        <ellipse cx="37" cy="77" rx="18" ry="55" fill="none" stroke="#1a4fc4" stroke-width=".7" />
        <line x1="37" y1="9" x2="37" y2="146" stroke="#1a4fc4" stroke-width=".6" />
</div>
<div class="board-body">
    <div class="board-name">Groveller 5'10"</div>
    <div class="board-shaper">Rocca · Punta del Este</div>
    <div class="board-compat">85% compatible</div>
    <div class="board-price">USD 490</div>
</div>
</div>
</div>
</section>

<!-- SEGUIMIENTO -->
<section class="zp-section zp-section-dark">
    <div class="tc">
        <span class="zp-eyebrow">Seguimiento del pedido</span>
        <span class="zp-title">SABÉS DÓNDE ESTÁ TU TABLA</span>
    </div>
    <div class="track-card">
        <div class="track-header">
            <span class="track-id">Pedido #ZSG-0421</span>
            <span class="track-badge">En fabricación</span>
        </div>
        <div class="track-sub">Shortboard 6'2" · Shaper Montevideo · Est. 3-5 semanas</div>
        <div class="track-steps">
            <div class="tstep done"><div class="tdot"></div><span>Recibido</span></div>
            <div class="tline done"></div>
            <div class="tstep done"><div class="tdot"></div><span>Diseño OK</span></div>
            <div class="tline done"></div>
            <div class="tstep active"><div class="tdot"></div><span>Shaping</span></div>
            <div class="tline"></div>
            <div class="tstep"><div class="tdot"></div><span>Laminado</span></div>
            <div class="tline"></div>
            <div class="tstep"><div class="tdot"></div><span>Terminaciones</span></div>
            <div class="tline"></div>
            <div class="tstep"><div class="tdot"></div><span>Lista</span></div>
            <div class="tline"></div>
            <div class="tstep"><div class="tdot"></div><span>Entregada</span></div>
        </div>
    </div>
</section>

<!-- GALERÍA COMUNIDAD -->
<section class="zp-section zp-section-pale">
    <div class="tc">
        <span class="zp-eyebrow">Galería comunidad</span>
        <span class="zp-title" style="color:var(--blue);">TABLAS REALES, SURFISTAS REALES</span>
    </div>
    <div class="gallery">
        <div class="gallery-item"><i class="ti ti-photo" aria-hidden="true"></i></div>
        <div class="gallery-item"><i class="ti ti-photo" aria-hidden="true"></i></div>
        <div class="gallery-item"><i class="ti ti-photo" aria-hidden="true"></i></div>
        <div class="gallery-item"><i class="ti ti-photo" aria-hidden="true"></i></div>
        <div class="gallery-item"><i class="ti ti-photo" aria-hidden="true"></i></div>
    </div>
    <p class="gallery-caption" style="margin-top:.9rem;">Comunidad Zephyr Surf Go</p>
</section>

<!-- CTA DOBLE -->
<section class="zp-section zp-section-dark">
    <div class="cta-grid">
        <div class="cta-card">
            <h3>¿BUSCÁS TU TABLA?</h3>
            <p>Completá el cuestionario y encontrá la tabla ideal para tu nivel y el tipo de olas que surfeas.</p>
            <a href="#" class="cta-main" style="font-size:.74rem;">Empezar cuestionario →</a>
        </div>
        <div class="cta-card accent">
            <h3>¿SOS SHAPER?</h3>
            <p>Unite a la plataforma y empezá a recibir pedidos completos y organizados desde el primer día.</p>
            <a href="#" class="zp-btn-ghost" style="font-size:.74rem;">Sumar mi marca →</a>
        </div>
    </div>
</section>

<!-- FOOTER -->
<footer>
    <div class="footer-inner">
        <div>
            <div class="footer-logo">ZEPHYR <span>SURF</span> GO</div>
            <div class="footer-tagline">El marketplace de tablas artesanales de Latinoamérica.</div>
        </div>
        <div class="footer-col">
            <h6>Plataforma</h6>
            <ul>
                <li><a href="#">Home</a></li>
                <li><a href="#">Tablas</a></li>
                <li><a href="#">Shapers</a></li>
                <li><a href="#">Dealers</a></li>
            </ul>
        </div>
        <div class="footer-col">
            <h6>Soporte</h6>
            <ul>
                <li><a href="#">Contacto</a></li>
                <li><a href="#">FAQ</a></li>
                <li><a href="#">Privacidad</a></li>
            </ul>
        </div>
        <div class="footer-col">
            <h6>Seguinos</h6>
            <ul>
                <li><a href="#">Instagram</a></li>
                <li><a href="#">TikTok</a></li>
            </ul>
        </div>
    </div>
    <p class="footer-copy">© 2025 Zephyr Surf Go — Todos los derechos reservados.</p>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/Home.js" asp-append-version="true"></script>
    <script src="~/js/navbar.js" asp-append-version="true"></script>
</body>
</html>