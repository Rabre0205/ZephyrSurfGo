@model IReadOnlyList<ClassLibrary.Notificaciones.NotificacionUsuario>
@{Layout=null;}
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Notificaciones — Zephyr Surf Go</title><link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true"><link rel="stylesheet" href="~/css/notificaciones.css" asp-append-version="true"></head><body><partial name="_Navbar"/><main class="notifications-page"><header class="notifications-header"><div><span>Tu actividad</span><h1>NOTIFICACIONES</h1><p>Pedidos, cotizaciones, seguridad y respuestas importantes en un mismo lugar.</p></div>@if(Model.Any(x=>!x.Leida)){<form asp-action="LeerTodas" method="post">@Html.AntiForgeryToken()<button>Marcar todas como leídas</button></form>}</header><section class="notifications-list">@if(Model.Count==0){<div class="notifications-empty"><strong>No tenés notificaciones</strong><p>Cuando haya novedades importantes aparecerán acá.</p></div>}else{@foreach(var item in Model){<article class="notification-item @(item.Leida?"read":"unread")"><span class="notification-dot"></span><div><small>@item.Tipo · @item.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small><h2>@item.Titulo</h2><p>@item.Mensaje</p></div><div class="notification-actions">@if(!string.IsNullOrWhiteSpace(item.Url)){<form asp-action="Leer" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id"><input type="hidden" name="volver" value="@item.Url"><button>Ver detalle</button></form>}else if(!item.Leida){<form asp-action="Leer" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@item.Id"><button>Marcar como leída</button></form>}</div></article>}}</section></main><script src="~/js/navbar.js" asp-append-version="true"></script></body></html>
