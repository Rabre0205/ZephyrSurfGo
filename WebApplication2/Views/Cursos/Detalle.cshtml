@model ClassLibrary.Cursos.CursoShaper
@{ViewData["Title"]=Model.Titulo;bool propietario=ViewBag.EsPropietario==true;var opciones=Model.Modulos.Where(m=>m.PermiteCompraIndividual&&m.Precio.HasValue).ToList();}
<link rel="stylesheet" href="~/css/cursos.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/cursos-workshop.css" asp-append-version="true" /><partial name="_Navbar" />
<main class="course-detail"><section class="course-detail-visual" style="background-image:linear-gradient(180deg,transparent,rgba(24,23,19,.78)),url('@(Model.ImagenUrl??Url.Content("~/img/editorial/hero-workshop.jpg"))')"><a asp-controller="Shaper" asp-action="Detalle" asp-route-id="@Model.ShaperId">← Volver al shaper</a><div><span>@Model.Modalidad · @Model.FechaInicio.ToLocalTime().ToString("dd/MM/yyyy")</span><h1>@Model.Titulo</h1><p>Con @Model.InstructorNombre · @(string.IsNullOrWhiteSpace(Model.NegocioShaper)?Model.ShaperNombre:Model.NegocioShaper)</p></div></section>
<section class="course-detail-copy"><span class="course-kicker">Aprender haciendo</span><p class="course-lead">@Model.Resumen</p><div class="course-description">@foreach(string linea in Model.Descripcion.Split('\n',StringSplitOptions.RemoveEmptyEntries)){<p>@linea</p>}</div>
<dl class="course-facts"><div><dt>Modalidad</dt><dd>@Model.Modalidad</dd></div><div><dt>Ubicación</dt><dd>@Model.Ubicacion</dd></div><div><dt>Duración</dt><dd>@Model.DuracionHoras.ToString("0.#") horas</dd></div><div><dt>Cupos</dt><dd>@Model.CuposDisponibles disponibles</dd></div><div><dt>Financiación</dt><dd>Hasta @Model.CuotasMaximas cuota@(Model.CuotasMaximas==1?"":"s")</dd></div>@if(Model.HospedajeDisponible){<div><dt>Para quienes viajan</dt><dd>Hospedaje disponible a consultar</dd></div>}</dl>

@if(Model.Modulos.Count>0){<section class="course-content-section"><span class="course-kicker">Paso a paso</span><h2>Programa del workshop</h2><div class="course-module-list">@foreach(var modulo in Model.Modulos){<article><span>@(modulo.Orden+1).ToString("00")</span><div><h3>@modulo.Nombre</h3><p>@modulo.Descripcion</p><small>@modulo.Encuentros encuentro@(modulo.Encuentros==1?"":"s") · @modulo.DuracionHoras.ToString("0.#") h@if(modulo.PermiteCompraIndividual&&modulo.Precio.HasValue){<text> · USD @modulo.Precio.GetValueOrDefault().ToString("N2")</text>}</small></div></article>}</div></section>}

<div class="course-two-columns"><section class="course-content-section"><span class="course-kicker">La experiencia</span><h2>¿Qué incluye?</h2>@foreach(string linea in Model.Incluye.Split('\n',StringSplitOptions.RemoveEmptyEntries)){<p class="course-list-item">✓ @linea.Trim()</p>}</section><section class="course-content-section"><span class="course-kicker">Para vos</span><h2>¿A quién está dirigido?</h2>@foreach(string linea in Model.PublicoObjetivo.Split('\n',StringSplitOptions.RemoveEmptyEntries)){<p class="course-list-item">@linea.Trim()</p>}@if(!string.IsNullOrWhiteSpace(Model.Requisitos)){<h3>Requisitos</h3><p>@Model.Requisitos</p>}</section></div>

<section class="course-instructor"><span class="course-kicker">Tu instructor</span><h2>@Model.InstructorNombre</h2><p>@Model.InstructorBio</p></section>
@if(Model.Imagenes.Count>0){<section class="course-gallery" aria-label="Galería del workshop">@foreach(var imagen in Model.Imagenes){<img src="@imagen" alt="Experiencia del workshop @Model.Titulo" loading="lazy">}</section>}

<aside class="course-booking"><div><small>Workshop completo</small><strong>USD @Model.Precio.ToString("N2")</strong>@if(Model.DescuentoAcompanantePorcentaje>0){<p>@Model.DescuentoAcompanantePorcentaje.ToString("0.##")% de descuento al venir con un acompañante.</p>}@if(!string.IsNullOrWhiteSpace(Model.CronogramaUrl)){<a href="@Model.CronogramaUrl" target="_blank" rel="noopener">Ver cronograma completo ↗</a>}@if(!string.IsNullOrWhiteSpace(Model.Contacto)){<p>Consultas: @Model.Contacto</p>}</div>
@if(TempData["Mensaje"] is string ok){<p class="course-success">@ok</p>}@if(TempData["Error"] is string error){<p class="course-error">@error</p>}
@if(propietario){<a asp-action="Editar" asp-route-id="@Model.Id" class="course-primary">Editar publicación</a>}else if(User.IsInRole("Cliente")&&Model.CuposDisponibles>0){<form asp-action="Inscribirse" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"><label for="moduloId">Elegí una opción</label><select name="moduloId" id="moduloId"><option value="">Workshop completo · USD @Model.Precio.ToString("N2")</option>@foreach(var modulo in opciones){<option value="@modulo.Id">@modulo.Nombre · USD @modulo.Precio.GetValueOrDefault().ToString("N2")</option>}</select><button class="course-primary">Reservar mi lugar</button></form>}else if(Model.CuposDisponibles==0){<button disabled>Sin cupos</button>}</aside></section></main><script src="~/js/navbar.js" asp-append-version="true"></script>
