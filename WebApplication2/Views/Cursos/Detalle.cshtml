@model ClassLibrary.Cursos.CursoShaper
@{ViewData["Title"]=Model.Titulo;bool propietario=ViewBag.EsPropietario==true;}
<link rel="stylesheet" href="~/css/cursos.css" asp-append-version="true" /><partial name="_Navbar" />
<main class="course-detail"><section class="course-detail-visual" style="background-image:linear-gradient(180deg,transparent,rgba(24,23,19,.7)),url('@(Model.ImagenUrl??Url.Content("~/img/editorial/hero-workshop.jpg"))')"><a asp-controller="Shaper" asp-action="Detalle" asp-route-id="@Model.ShaperId">← Volver al shaper</a><div><span>@Model.Modalidad · @Model.FechaInicio.ToLocalTime().ToString("dd/MM/yyyy")</span><h1>@Model.Titulo</h1><p>Por @(string.IsNullOrWhiteSpace(Model.NegocioShaper)?Model.ShaperNombre:Model.NegocioShaper)</p></div></section>
<section class="course-detail-copy"><span class="course-kicker">Aprender el oficio</span><p class="course-lead">@Model.Resumen</p><div class="course-description">@foreach(string linea in Model.Descripcion.Split('\n',StringSplitOptions.RemoveEmptyEntries)){<p>@linea</p>}</div><dl class="course-facts"><div><dt>Modalidad</dt><dd>@Model.Modalidad</dd></div><div><dt>Ubicación</dt><dd>@Model.Ubicacion</dd></div><div><dt>Duración</dt><dd>@Model.DuracionHoras.ToString("0.#") horas</dd></div><div><dt>Lugares</dt><dd>@Model.CuposDisponibles disponibles</dd></div></dl>
<aside class="course-booking"><small>Valor por persona</small><strong>USD @Model.Precio.ToString("N2")</strong>@if(TempData["Mensaje"] is string ok){<p class="course-success">@ok</p>}@if(TempData["Error"] is string error){<p class="course-error">@error</p>}@if(propietario){<a asp-action="Editar" asp-route-id="@Model.Id" class="course-primary">Editar publicación</a>}else if(User.IsInRole("Cliente")&&Model.CuposDisponibles>0){<form asp-action="Inscribirse" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id"><button class="course-primary">Reservar mi lugar</button></form>}else if(Model.CuposDisponibles==0){<button disabled>Sin cupos</button>}</aside></section></main><script src="~/js/navbar.js" asp-append-version="true"></script>
