@model List<ClassLibrary.Cursos.InscripcionCurso>
@{ViewData["Title"]="Inscripciones";}
<link rel="stylesheet" href="~/css/cursos.css" asp-append-version="true" /><partial name="_Navbar" />
<main class="course-page"><a asp-action="Index" class="course-back">← Volver a cursos</a><header class="course-heading"><div><span>Ventas de formación</span><h1>Inscripciones</h1><p>Importes registrados al momento de reservar. Los estados pendientes no representan pagos confirmados.</p></div></header><div class="course-table-wrap"><table><thead><tr><th>Cliente</th><th>Opción</th><th>Precio</th><th>Comisión Zephyr</th><th>Neto shaper</th><th>Estado</th><th>Fecha</th></tr></thead><tbody>@foreach(var i in Model){<tr><td><strong>@i.ClienteNombre</strong><small>@i.ClienteEmail</small></td><td>@i.OpcionElegida</td><td>USD @i.Precio.ToString("N2")</td><td>USD @i.ComisionPlataforma.ToString("N2") (@i.PorcentajeComision.ToString("0.##")%)</td><td>USD @i.NetoShaper.ToString("N2")</td><td><span class="course-status">@(i.Estado==0?"Pago pendiente":i.Estado==1?"Confirmada":"Cancelada")</span></td><td>@i.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</td></tr>}</tbody></table>@if(Model.Count==0){<p class="course-empty-row">Todavía no hay inscripciones.</p>}</div></main><script src="~/js/navbar.js" asp-append-version="true"></script>
