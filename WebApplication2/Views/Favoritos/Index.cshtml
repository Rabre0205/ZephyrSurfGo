@model List<ClassLibrary.Interacciones.FavoritoProducto>
@{ Layout = null; }
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>Mis favoritos</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"><link rel="stylesheet" href="~/css/navbar.css"></head><body><partial name="_Navbar"/><main class="container py-5" style="margin-top:70px;max-width:1100px"><small class="text-primary text-uppercase fw-bold">Tu lista</small><h1>Mis favoritos</h1><p class="text-secondary">Guardarlos no reserva el stock ni congela el precio.</p>@if(Model.Count==0){<section class="border rounded-4 p-5 text-center"><h2 class="h4">Todavía no guardaste productos</h2><a asp-controller="Surf" asp-action="Shapers" class="btn btn-primary mt-2">Explorar shapers</a></section>}else{<div class="row g-4">@foreach(var p in Model){<div class="col-md-4"><article class="card h-100"><img src="@(string.IsNullOrWhiteSpace(p.ImagenUrl)?Url.Content("~/img/tabla.png"):p.ImagenUrl)" class="card-img-top" style="height:260px;object-fit:contain;background:#0b1730" alt="@p.Titulo"><div class="card-body"><small>@p.TipoProducto · @p.Subtitulo</small><h2 class="h5">@p.Titulo</h2><strong>USD @p.Precio.ToString("N2")</strong><div class="d-flex gap-2 mt-3"><a asp-controller="Shaper" asp-action="Detalle" asp-route-id="@p.ShaperId" class="btn btn-primary">Ver producto</a><form asp-action="Alternar" method="post">@Html.AntiForgeryToken()<input type="hidden" name="productoId" value="@p.ProductoId"><button class="btn btn-outline-danger">Quitar</button></form></div></div></article></div>}</div>}</main><script src="~/js/navbar.js"></script></body></html>
