@model List<ClassLibrary.Interacciones.FavoritoProducto>
@{ Layout = null; int noDisponibles=Model.Count(x=>!x.Disponible); int cambios=Model.Count(x=>x.CambioPrecio); }
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Mis favoritos</title><link rel="stylesheet" href="~/css/navbar.css"><link rel="stylesheet" href="~/css/bibliotecaCliente.css" asp-append-version="true"></head><body><partial name="_Navbar" />
<main class="library-page"><header class="library-hero"><div><span>Tu selección</span><h1>Mis favoritos</h1><p>Guardarlos no reserva el stock ni congela el precio. Te avisamos cuando algo cambia.</p></div><div class="library-stats"><strong>@Model.Count</strong><span>guardados</span>@if(noDisponibles>0){<strong>@noDisponibles</strong><span>no disponibles</span>}@if(cambios>0){<strong>@cambios</strong><span>con precio nuevo</span>}</div></header>
@if(TempData["Mensaje"] is string mensaje){<div class="library-alert success">@mensaje</div>}@if(TempData["Error"] is string error){<div class="library-alert error">@error</div>}
@if(Model.Count==0){<section class="library-empty"><span>♡</span><h2>Todavía no guardaste productos</h2><p>Explorá los talleres y guardá las tablas o accesorios que quieras comparar más adelante.</p><a asp-controller="Surf" asp-action="shapers" class="library-primary">Explorar shapers</a></section>}
else{<form asp-action="EliminarSeleccionados" method="post" id="favoritesBulkForm">@Html.AntiForgeryToken()<div class="library-toolbar"><label><input type="checkbox" data-select-all> Seleccionar todos</label><button class="library-danger" type="submit" data-bulk-submit disabled>Quitar seleccionados</button></div><section class="favorite-grid">@foreach(var p in Model){<article class="favorite-card @(!p.Disponible?"unavailable":"")"><label class="select-item" aria-label="Seleccionar @p.Titulo"><input type="checkbox" name="productoIds" value="@p.ProductoId" data-item-check></label><div class="favorite-image"><img src="@(string.IsNullOrWhiteSpace(p.ImagenUrl)?Url.Content("~/img/tabla.png"):p.ImagenUrl)" alt="@p.Titulo">@if(!p.Disponible){<span>No disponible</span>}else if(p.Stock.HasValue&&p.Stock<=3){<span>Últimas @p.Stock</span>}</div><div class="favorite-copy"><small>@p.TipoProducto · @p.Subtitulo</small><h2>@p.Titulo</h2><div class="favorite-price"><strong>USD @p.Precio.ToString("N2")</strong>@if(p.CambioPrecio){<span>Antes USD @p.PrecioGuardado.ToString("N2")</span>}</div>@if(p.CambioPrecio){<p class="change-note">El precio cambió desde que lo guardaste.</p>}<div class="favorite-actions">@if(p.Disponible){<a asp-controller="Shaper" asp-action="Producto" asp-route-id="@p.ProductoId" class="library-primary">Ver producto</a>}else{<span class="disabled-action">Esperando disponibilidad</span>}<button type="submit" formaction="@Url.Action("Alternar")" name="productoId" value="@p.ProductoId" class="text-action">Quitar</button></div></div></article>}</section></form>}
</main><script src="~/js/bibliotecaCliente.js" asp-append-version="true"></script><script src="~/js/navbar.js"></script></body></html>
