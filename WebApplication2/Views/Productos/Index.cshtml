@model List<ClassLibrary.Productos.Producto>

@{
    ViewData["Title"] = "Mis productos";
}

<h1>Mis productos</h1>

@if (TempData["Mensaje"] != null)
{
    <p>
        @TempData["Mensaje"]
    </p>
}

<a asp-controller="Productos"
   asp-action="Crear">
    Crear tabla
</a>

@if (Model == null || Model.Count == 0)
{
    <p>
        Todavía no creaste productos.
    </p>
}
else
{
    <div>
        @foreach (var producto in Model)
        {
            <article>
                @if (!string.IsNullOrWhiteSpace(
                    producto.ImagenUrl))
                {
                    <img src="@producto.ImagenUrl"
                         alt="@producto.Titulo"
                         style="max-width:180px;" />
                }

                <h2>@producto.Titulo</h2>

                <p>@producto.Subtitulo</p>

                <p>
                    USD @producto.Precio.ToString("0.00")
                </p>

                <a asp-controller="Productos"
                   asp-action="Editar"
                   asp-route-id="@producto.Id">
                    Editar
                </a>
            </article>
        }
    </div>
}