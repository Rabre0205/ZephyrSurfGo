@model WebApplication2.Models.Productos.TablaFormModel

@{
    ViewData["Title"] = "Publicar tabla";
}

<link rel="stylesheet" href="~/css/estilosCrearProducto.css" asp-append-version="true" />

<section class="publicar-tabla-page">
    <header class="publicar-header">
        <a asp-controller="Productos" asp-action="Index" class="volver-productos">← Volver a mis productos</a>
        <span class="publicar-eyebrow">Nueva publicación</span>
        <h1>Publicá una tabla</h1>
        <p>Completá la información para que tus clientes puedan conocerla y elegirla con confianza.</p>
    </header>

    <form asp-controller="Productos" asp-action="Crear" method="post"
          enctype="multipart/form-data" class="publicar-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="publicar-validacion" role="alert"></div>

        <section class="form-seccion">
            <div class="seccion-encabezado">
                <span class="seccion-numero">01</span>
                <div><h2>Información principal</h2><p>Estos datos serán lo primero que verá el cliente.</p></div>
            </div>
            <div class="campos-grid">
                <div class="campo campo-ancho">
                    <label asp-for="Titulo">Nombre de la tabla <span>*</span></label>
                    <input asp-for="Titulo" placeholder="Ejemplo: Wave Rider Pro" autocomplete="off" />
                    <small>Usá un nombre breve y fácil de reconocer.</small>
                    <span asp-validation-for="Titulo" class="campo-error"></span>
                </div>
                <div class="campo campo-ancho">
                    <label asp-for="Subtitulo">Subtítulo</label>
                    <input asp-for="Subtitulo" placeholder="Ejemplo: Rendimiento y control para olas potentes" />
                    <small>Resumí en una frase para quién está pensada.</small>
                </div>
                <div class="campo">
                    <label asp-for="Precio">Precio <span>*</span></label>
                    <div class="input-unidad unidad-izquierda">
                        <span>USD</span>
                        <input asp-for="Precio" type="number" step="0.01" min="0" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="Precio" class="campo-error"></span>
                </div>
                <div class="campo campo-ancho">
                    <label asp-for="Descripcion">Descripción</label>
                    <textarea asp-for="Descripcion" rows="5" placeholder="Contá cómo se comporta, sus materiales y qué la hace especial..."></textarea>
                    <small>Una descripción clara ayuda al cliente a tomar una mejor decisión.</small>
                </div>
            </div>
        </section>

        <section class="form-seccion">
            <div class="seccion-encabezado">
                <span class="seccion-numero">02</span>
                <div><h2>Imágenes de la tabla</h2><p>Mostrá ambos lados con buena luz y el fondo despejado.</p></div>
            </div>
            <div class="imagenes-grid">
                <label class="imagen-campo">
                    <span class="imagen-icono" aria-hidden="true">↑</span>
                    <strong>Imagen frontal <em>*</em></strong>
                    <small>JPG, PNG o WEBP</small>
                    <input asp-for="ImagenFrontal" type="file" accept=".jpg,.jpeg,.png,.webp" />
                    <span asp-validation-for="ImagenFrontal" class="campo-error"></span>
                </label>
                <label class="imagen-campo">
                    <span class="imagen-icono" aria-hidden="true">↑</span>
                    <strong>Imagen trasera</strong>
                    <small>JPG, PNG o WEBP</small>
                    <input asp-for="ImagenTrasera" type="file" accept=".jpg,.jpeg,.png,.webp" />
                </label>
            </div>
        </section>

        <section class="form-seccion">
            <div class="seccion-encabezado">
                <span class="seccion-numero">03</span>
                <div><h2>Medidas y configuración</h2><p>Indicá las características técnicas de la tabla.</p></div>
            </div>
            <div class="campos-grid tres-columnas">
                <div class="campo"><label asp-for="Altura">Altura</label><input asp-for="Altura" placeholder="Ejemplo: 6'2&quot;" /></div>
                <div class="campo">
                    <label asp-for="Ancho">Ancho</label>
                    <div class="input-unidad"><input asp-for="Ancho" type="number" min="0" /><span>in</span></div>
                </div>
                <div class="campo">
                    <label asp-for="Volumen">Volumen</label>
                    <div class="input-unidad"><input asp-for="Volumen" type="number" step="0.01" min="0" /><span>L</span></div>
                </div>
                <div class="campo campo-ancho">
                    <label asp-for="SistemaDeEncaje">Sistema de quillas</label>
                    <select asp-for="SistemaDeEncaje"><option value="0">FCS2</option><option value="1">Future</option></select>
                </div>
            </div>
        </section>

        <section class="form-seccion">
            <div class="seccion-encabezado">
                <span class="seccion-numero">04</span>
                <div><h2>Recomendación de uso</h2><p>Ayudá al cliente a saber si esta tabla es adecuada para él.</p></div>
            </div>
            <div class="campos-grid">
                <div class="campo">
                    <label asp-for="TipoDeOla">Tipo de ola</label>
                    <select asp-for="TipoDeOla"><option value="0">Plana</option><option value="1">Power</option><option value="2">Chica</option></select>
                </div>
                <div class="campo">
                    <label asp-for="EstiloDeSurf">Estilo de surf</label>
                    <select asp-for="EstiloDeSurf"><option value="0">Agresivo</option><option value="1">Fluido</option><option value="2">Versátil</option><option value="3">Recreativo</option></select>
                </div>
                <div class="campo">
                    <label asp-for="PesoMinimo">Peso mínimo</label>
                    <div class="input-unidad"><input asp-for="PesoMinimo" type="number" min="0" /><span>kg</span></div>
                </div>
                <div class="campo">
                    <label asp-for="PesoMaximo">Peso máximo</label>
                    <div class="input-unidad"><input asp-for="PesoMaximo" type="number" min="0" /><span>kg</span></div>
                </div>
                <div class="campo campo-ancho">
                    <label asp-for="Experiencia">Nivel de experiencia</label>
                    <select asp-for="Experiencia"><option value="0">Sin experiencia</option><option value="1">Iniciado</option><option value="2">Intermedio</option><option value="3">Avanzado</option></select>
                </div>
            </div>
        </section>

        <footer class="form-acciones">
            <div><strong>¿Está todo pronto?</strong><span>Podrás editar esta información después.</span></div>
            <div class="form-botones">
                <a asp-controller="Productos" asp-action="Index" class="btn-cancelar">Cancelar</a>
                <button type="submit" class="btn-publicar">Publicar tabla →</button>
            </div>
        </footer>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
