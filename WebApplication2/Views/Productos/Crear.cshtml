@model WebApplication2.Models.Productos.TablaFormModel

@{
    ViewData["Title"] = "Crear tabla";
}

<h1>Crear tabla</h1>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All"></div>
}

<form asp-controller="Productos"
      asp-action="Crear"
      method="post"
      enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <div>
        <label asp-for="Titulo">
            Título
        </label>

        <input asp-for="Titulo" />

        <span asp-validation-for="Titulo"></span>
    </div>

    <div>
        <label asp-for="Subtitulo">
            Subtítulo
        </label>

        <input asp-for="Subtitulo" />
    </div>

    <div>
        <label asp-for="Precio">
            Precio
        </label>

        <input asp-for="Precio"
               type="number"
               step="0.01"
               min="0" />

        <span asp-validation-for="Precio"></span>
    </div>

    <div>
        <label asp-for="Descripcion">
            Descripción
        </label>

        <textarea asp-for="Descripcion"
                  rows="5"></textarea>
    </div>

    <div>
        <label asp-for="ImagenFrontal">
            Imagen frontal
        </label>

        <input asp-for="ImagenFrontal"
               type="file"
               accept=".jpg,.jpeg,.png,.webp" />

        <span asp-validation-for="ImagenFrontal"></span>
    </div>

    <div>
        <label asp-for="ImagenTrasera">
            Imagen trasera
        </label>

        <input asp-for="ImagenTrasera"
               type="file"
               accept=".jpg,.jpeg,.png,.webp" />
    </div>

    <div>
        <label asp-for="Altura">
            Altura
        </label>

        <input asp-for="Altura"
               placeholder="Ejemplo: 6'2&quot;" />
    </div>

    <div>
        <label asp-for="Ancho">
            Ancho
        </label>

        <input asp-for="Ancho"
               type="number"
               min="0" />
    </div>

    <div>
        <label asp-for="Volumen">
            Volumen
        </label>

        <input asp-for="Volumen"
               type="number"
               step="0.01"
               min="0" />
    </div>

    <div>
        <label asp-for="SistemaDeEncaje">
            Sistema de encaje
        </label>

        <select asp-for="SistemaDeEncaje">
            <option value="0">FCS2</option>
            <option value="1">Future</option>
        </select>
    </div>

    <div>
        <label asp-for="TipoDeOla">
            Tipo de ola
        </label>

        <select asp-for="TipoDeOla">
            <option value="0">Plana</option>
            <option value="1">Power</option>
            <option value="2">Chica</option>
        </select>
    </div>

    <div>
        <label asp-for="EstiloDeSurf">
            Estilo de surf
        </label>

        <select asp-for="EstiloDeSurf">
            <option value="0">Agresivo</option>
            <option value="1">Fluido</option>
            <option value="2">Versátil</option>
            <option value="3">Recreativo</option>
        </select>
    </div>

    <div>
        <label asp-for="PesoMinimo">
            Peso mínimo
        </label>

        <input asp-for="PesoMinimo"
               type="number"
               min="0" />
    </div>

    <div>
        <label asp-for="PesoMaximo">
            Peso máximo
        </label>

        <input asp-for="PesoMaximo"
               type="number"
               min="0" />
    </div>

    <div>
        <label asp-for="Experiencia">
            Experiencia
        </label>

        <select asp-for="Experiencia">
            <option value="0">Sin experiencia</option>
            <option value="1">Iniciado</option>
            <option value="2">Intermedio</option>
            <option value="3">Avanzado</option>
        </select>
    </div>

    <button type="submit">
        Guardar tabla
    </button>

    <a asp-controller="Productos"
       asp-action="Index">
        Cancelar
    </a>
</form>